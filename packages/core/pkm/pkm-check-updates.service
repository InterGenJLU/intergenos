# pkm-check-updates.service — Q8 Phase B (notification-surface substrate)
#
# Oneshot service that runs `pkm check-updates --quiet`, which writes a
# JSON summary of available upgrades to /var/lib/pkm/available-updates.json.
# Consumed by:
#   - GNOME shell extension intergen-pkm-notifier (Q8 Phase C)
#   - /etc/update-motd.d/90-pkm-pending (Q8 Phase D)
#
# NEVER auto-upgrades — informational only per the approved Q8
# design. The CLI in pkm Phase A only writes the JSON; consumers decide
# what UX to render. User explicitly invokes `pkm upgrade --all` to act.
#
# Schedule: pkm-check-updates.timer fires this service daily with a 4h
# randomized delay (avoid mirror thundering-herd at midnight UTC).
#
# Runs as root because /var/lib/pkm/ + the trust store + the pkm DB are
# all root-owned. check-updates is a read-only operation against repo
# index + installed DB; it does not mutate package state.

[Unit]
Description=Check for available pkm package upgrades
Documentation=man:pkm(1)
# No network ordering: pkm check-updates is OFFLINE by design. It reads the
# LAST-SYNCED cached index under /var/cache/pkm/db/ (GPG-reverified) plus the
# installed DB and writes the available-updates JSON — it never reaches the
# mirror. A background timer silently phoning home would violate the
# user-controls-their-own-machine directive; the user syncs explicitly via
# `pkm update`. Confirmed offline: `strace -e trace=connect` shows zero
# AF_INET connects and the cached index is byte-identical across a run.

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/pkm check-updates --quiet
# Stdout/stderr to journal so `journalctl -u pkm-check-updates.service`
# shows the WARN-and-skip messages from VersionParseError edge cases.
StandardOutput=journal
StandardError=journal
# No Restart=: the timer is the schedule controller. A transient failure
# (network blip, mirror 503) just means this run produced no JSON update;
# next timer fire retries. A persistent failure surfaces in journalctl
# and via no-JSON-update via the consumer surfaces.

# Hardening — F-048/F-049 closure (T0-4-A Commit 3; matrix row 211 +
# line 1309). Per RATIFIED 2026-04-29 4-0 unanimous AppArmor + daemon-
# hardening baseline: every InterGenOS-authored service ships with the
# systemd canonical hardening directive set. This service runs as root
# but is read-only against repo + DB (writes only the available-updates
# JSON to /var/lib/pkm/) — so the hardening set is the full canonical
# set with ReadWritePaths=/var/lib/pkm scoped narrowly. CapabilityBoundingSet
# + AmbientCapabilities cleared since check-updates needs no Linux
# capabilities (read the cached repo index + read DB file + write JSON).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_INET/AF_INET6 retained deliberately: check-updates makes no network
# CONNECT (offline, see [Unit] note), but tightening to AF_UNIX-only needs a
# runtime check first — `strace -e connect` proves no connect, not that the
# Python/gpgv path never CREATES an INET socket (which this filter would
# EPERM). Follow-up: validate on a target, then narrow if safe.
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
ReadWritePaths=/var/lib/pkm
# CacheDirectory=pkm — check-updates reads/writes the cached repo index under
# /var/cache/pkm/db/ (pkm/repo.py REPO_DB_CACHE.mkdir). ProtectSystem=strict
# makes /var/cache read-only, and on a clean from-ISO install /var/cache/pkm
# does not exist yet — so the bare mkdir raised
# `OSError: [Errno 30] Read-only file system: '/var/cache/pkm'`, failing the
# unit (degraded system, 1 failed unit) on a pristine GBC004.1 install (.192).
# CacheDirectory= both CREATES /var/cache/pkm (if absent) and makes it writable
# for this sandboxed unit — the systemd-canonical fix, narrower than widening
# ReadWritePaths and correct on first boot. pkm sets the 0700 mode on the
# packages/ subdir itself (repo.py L-021); the 0755 parent is standard for
# /var/cache.
CacheDirectory=pkm
CapabilityBoundingSet=
AmbientCapabilities=
