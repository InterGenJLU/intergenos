abi <abi/3.0>,

include <tunables/global>

profile pkm /usr/bin/pkm flags=(complain) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/python>
  include <abstractions/ssl_certs>
  include <abstractions/gnupg>

  capability chown,
  capability dac_override,
  capability fowner,
  capability fsetid,
  capability setgid,
  capability setuid,
  capability sys_admin,

  # Executable
  /usr/bin/pkm r,

  # The program this profile confines is a shell script that execs the
  # Python interpreter, so the interpreter is the process that does the
  # work and every rule below applies to it only if this domain keeps it.
  # Measured on kernel 6.18.10 with parser 3.1.7, in complain mode, with
  # the records read back from the kernel log: with no rule here the exec
  # is recorded as entering a learning child (target="...//null-
  # /usr/bin/python3.14"), whose domain mediates no network, unix socket,
  # signal, mount or user namespace at all, so the rules written here are
  # unreachable for the work; under enforce the same missing rule denies
  # the exec and the package manager cannot start. A rule naming the
  # symlink the launcher writes (/usr/bin/python3) does NOT match - the
  # kernel matches the file it resolves to - and the script's own
  # interpreter needs no rule, because this profile attaches at the
  # script and that interpreter runs inside it. ix keeps the interpreter
  # in this domain rather than granting it one of its own; the launcher
  # runs it with -P, so the working directory is not on its import path.
  /usr/bin/python3.14 rix,
  
  # Allow reading and modifying the entire filesystem (it's a package manager)
  /usr/ rwl,
  /usr/** rwlk,
  /etc/ r,
  /etc/** rwk,
  /var/lib/pkm/ rw,
  /var/lib/pkm/** rwk,
  /var/cache/pkm/ rw,
  /var/cache/pkm/** rwk,
  /etc/pkm/keys/ r,
  /etc/pkm/keys/** r,
  /tmp/pkm-*/ rw,
  /tmp/pkm-*/** rwk,
  /usr/bin/gpg ix,
  /usr/bin/tar ix,
  /usr/bin/sha256sum ix,
  
  # Trust anchors and GPG verification
  /etc/pkm/keys/ r,
  /etc/pkm/keys/** r,
  /usr/bin/gpg ix,
  
  # Network access for downloading packages. These two take effect only
  # because this file declares a feature abi above; with no abi line the
  # parser compiles them to nothing and says so.
  network inet stream,
  network inet6 stream,

  # WHAT THIS PROFILE CANNOT ENFORCE AS WRITTEN, on the shipped kernel
  # with the parser this package builds (3.1.7), measured rather than
  # assumed: abstractions/base above carries four extended unix socket
  # rules, and the parser enforces such a rule only when the feature
  # network/af_unix is in both the kernel's feature set and the abi the
  # policy declares. The abi carries it; kernel 6.18 publishes af_unix
  # under network_v9 and has no network node at all, so each of the four
  # is downgraded to a generic network rule and the parser prints one
  # warning per rule. The downgraded rule IS compiled into the policy, so
  # those four are enforced in a weaker form, not dropped; and no edit to
  # any profile changes it - compiling this same file against a feature
  # set that carries network/af_unix produces no warning at all. What
  # removes them is a parser version that reads this kernel's network_v9
  # feature. The source-tree check for this package allows exactly that
  # one warning class and no other.
}
