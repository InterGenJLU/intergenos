# haproxy-tls-keygen.service — per-machine TLS cert generation for HAProxy
#
# F43: the self-signed cert+key are generated on the TARGET at first service
# start (not at build/package time), so every machine gets a unique key and
# no key material ships in the squashfs. haproxy.service Requires= and is
# ordered After= this unit, so the cert exists before haproxy reads it. The
# unit is pulled in as a dependency of haproxy.service — it is NOT
# independently enabled (no [Install] section), so it only ever runs when
# haproxy is started.
#
# ConditionPathExists=! makes it a no-op once a cert is present (operator cert
# or a prior run); a condition-skip still satisfies haproxy's Requires=.

[Unit]
Description=Generate per-machine self-signed TLS certificate for HAProxy
ConditionPathExists=!/etc/haproxy/ssl/server.pem
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/haproxy/generate-tls-cert.sh
