[Unit]
Description=System logging service (rsyslog)
Documentation=man:rsyslogd(8) man:rsyslog.conf(5)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/sbin/rsyslogd -n -iNONE
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# The daemon runs as root to read root-owned logs and bind privileged sockets; the
# filesystem view is still read-only except where logs and queues are written.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/log /var/spool/rsyslog
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_SYSLOG CAP_CHOWN CAP_FOWNER
SystemCallArchitectures=native
UMask=0077
StandardOutput=null

[Install]
WantedBy=multi-user.target
