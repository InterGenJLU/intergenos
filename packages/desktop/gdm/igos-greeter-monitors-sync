#
# igos-greeter-monitors-sync <username> — sync a user's monitor layout to
# the GDM greeter (decided 2026-07-21).
#
# WHY: the greeter's gnome-shell has no display configuration of its own, so
# mutter enumerates connectors in arbitrary order at default scale — on a
# multi-monitor box the login screen renders stretched and shuffled. The
# standard mechanism IS a monitors.xml in the greeter's per-seat state
# (GDM 49 reads /var/lib/gdm/seat0/config/monitors.xml); upstream ships no
# session-to-greeter sync, so this helper closes that gap: it copies the
# named user's layout into the greeter seat state whenever it changes
# (driven by igos-greeter-monitors-sync@.path).
#
# OWNERSHIP IS DELIBERATELY NEVER TOUCHED. GDM 49 runs the greeter as a
# per-boot DynamicUser account and, at every greeter launch, gives the seat
# config directory and everything in it to that account and sets the
# directory 0700 (gdm_ensure_dir in gdm-launch-environment.c). The copy
# therefore lands root-owned 0600 and the greeter reads it as its owner after
# that launch; an existing config directory keeps the mode GDM gave it.
#
# THE BYTES THAT LAND ARE THE BYTES CHECKED. This helper runs as root and
# reads out of a directory the user controls, so it walks to that directory
# from / one component at a time by descriptor, never through a link, and
# holds the layout's name with O_PATH|O_NOFOLLOW, which opens nothing: the
# file type, owner and size come from that hold, and only a regular file the
# user owns is then opened, through the hold, as the same inode. A FIFO put
# at the name is never opened. It parses and copies the bytes it read from
# that one descriptor, so a name swapped after the hold cannot change what
# is copied.
#
# FAILURE POSTURE: fail loud, never degrade the greeter. A refused sync
# leaves the previous greeter layout in place; the worst case at the greeter
# is mutter's clone-all fallback. Recovery from a bad layout:
#   rm /var/lib/gdm/seat0/config/monitors.xml && systemctl restart gdm

set -euo pipefail

SEAT_CONFIG=/var/lib/gdm/seat0/config
MAX_BYTES=1048576   # monitors.xml is ~1-4 KB; anything near 1 MB is not one

fail() { echo "igos-greeter-monitors-sync: ERROR: $*" >&2; exit 1; }

[ $# -eq 1 ] || fail "usage: igos-greeter-monitors-sync <username>"
USERNAME="$1"

ENT="$(getent passwd "$USERNAME")" || fail "no such user: $USERNAME"
USER_HOME="$(printf '%s' "$ENT" | cut -d: -f6)"
USER_UID="$(printf '%s' "$ENT" | cut -d: -f3)"
[ -d "$USER_HOME" ] || fail "home directory missing for $USERNAME: $USER_HOME"

SRC="$USER_HOME/.config/monitors.xml"

# No layout saved yet — nothing to sync. Not an error: the path unit fires
# on the first write and every change thereafter.
if [ ! -e "$SRC" ]; then
    echo "igos-greeter-monitors-sync: $SRC absent, nothing to sync"
    exit 0
fi

# Ensure the seat state path exists. GDM itself keeps /var/lib/gdm and seat0
# root-owned 0755; the config directory is GDM's (see above) and is only
# created here, 0700, when it is absent.
install -dm755 /var/lib/gdm /var/lib/gdm/seat0

exec python3 -I - "$SRC" "$USER_UID" "$SEAT_CONFIG" "$MAX_BYTES" <<'PY'
import errno, hashlib, os, stat, sys
import xml.etree.ElementTree as ET

src, uid, seat_config, limit = sys.argv[1], int(sys.argv[2]), sys.argv[3], int(sys.argv[4])
PREFIX = "igos-greeter-monitors-sync"


def fail(message):
    print(f"{PREFIX}: ERROR: {message}", file=sys.stderr)
    sys.exit(1)


# Refuse anything but a plain regular file OWNED by that user, sized like a
# monitors.xml, judged from the hold before anything opens it. A link here
# could otherwise copy an arbitrary root-readable file into the greeter's
# seat state, and an open of a FIFO runs what the FIFO does when opened.
def walked(directory):
    """An O_PATH descriptor on `directory`, walked from / by descriptor,
    never through a link."""
    fd = os.open("/", os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    for part in [part for part in directory.split("/") if part]:
        try:
            below = os.open(part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW
                            | os.O_CLOEXEC, dir_fd=fd)
        finally:
            os.close(fd)
        fd = below
    return fd


src_dir, src_name = os.path.split(os.path.normpath(src))
try:
    dfd_src = walked(src_dir)
except FileNotFoundError:
    print(f"{PREFIX}: {src} absent, nothing to sync")
    sys.exit(0)
except OSError as exc:
    fail(f"{src_dir} is not a directory reached without a link "
         f"({exc.strerror}) — refusing")
try:
    held = os.open(src_name, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC,
                   dir_fd=dfd_src)
except FileNotFoundError:
    print(f"{PREFIX}: {src} absent, nothing to sync")
    sys.exit(0)
finally:
    os.close(dfd_src)
try:
    info = os.fstat(held)
    if stat.S_ISLNK(info.st_mode):
        fail(f"{src} is a symlink — refusing")
    if not stat.S_ISREG(info.st_mode):
        fail(f"{src} is not a regular file — refusing")
    if info.st_uid != uid:
        fail(f"{src} owned by uid {info.st_uid}, expected {uid} — refusing")
    if info.st_size > limit:
        fail(f"{src} is {info.st_size} bytes (limit {limit}) — refusing")
    fd = os.open(f"/proc/self/fd/{held}",
                 os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
finally:
    os.close(held)
try:
    opened = os.fstat(fd)
    if (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
        fail(f"{src} opened as another file than the one checked — refusing")
    os.set_blocking(fd, True)
    chunks, total = [], 0
    while total <= limit:
        chunk = os.read(fd, limit + 1 - total)
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
finally:
    os.close(fd)
data = b"".join(chunks)
if len(data) > limit:
    fail(f"{src} grew past {limit} bytes while it was read — refusing")

# Cheap validity gate: bytes that are not well-formed XML cannot be a
# monitors.xml — refuse them and keep the previous greeter layout.
try:
    ET.fromstring(data)
except ET.ParseError:
    fail(f"{src} is not well-formed XML — refusing")
digest = hashlib.sha256(data).hexdigest()

try:
    os.mkdir(seat_config, 0o700)
except FileExistsError:
    pass
except OSError as exc:
    fail(f"cannot create {seat_config} ({exc.strerror})")
try:
    dfd = os.open(seat_config, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
except OSError as exc:
    fail(f"cannot open {seat_config} ({exc.strerror}) — refusing")

# Atomic replace through a temporary file in the same directory, hashed in
# full from its own descriptor before the rename, so the greeter can never
# observe a torn file and the file it reads is the layout that was checked.
tmp = f".monitors.xml.{os.urandom(6).hex()}"
out = -1
try:
    out = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                  0o600, dir_fd=dfd)
    view = memoryview(data)
    while view:
        view = view[os.write(out, view):]
    os.fsync(out)
    os.lseek(out, 0, os.SEEK_SET)
    landed = hashlib.sha256()
    for chunk in iter(lambda: os.read(out, 65536), b""):
        landed.update(chunk)
    if landed.hexdigest() != digest:
        fail(f"the copy of {src} does not hash to the bytes checked — nothing replaced")
    os.fchmod(out, 0o600)
    os.close(out)
    out = -1
    os.replace(tmp, "monitors.xml", src_dir_fd=dfd, dst_dir_fd=dfd)
    tmp = None
except OSError as exc:
    fail(f"cannot write {seat_config}/monitors.xml ({exc.strerror})")
finally:
    if out >= 0:
        os.close(out)
    if tmp is not None:
        try:
            os.unlink(tmp, dir_fd=dfd)
        except OSError:
            pass
    os.close(dfd)

print(f"{PREFIX}: synced {src} -> {seat_config}/monitors.xml ({digest[:16]}...)")
PY
