Offline abseil population: upstream FetchContent-clones abseil-cpp from
GitHub at build time, which the network-isolated build chroot refuses.
Replace the git fetch with the staged sha-pinned tarball (declared in
package.yml, path supplied via SPM_ABSEIL_TARBALL) — the download step
still verifies the URL_HASH, so a missing or tampered file fails loudly.
Fails loud (patch reject) if upstream moves or reworks this block.
--- a/sentencepiece/CMakeLists.txt
+++ b/sentencepiece/CMakeLists.txt
@@ -188,10 +188,10 @@
 if (SPM_ABSL_PROVIDER STREQUAL "module")
   include(FetchContent)
   FetchContent_Populate(abseil-cpp
-        GIT_REPOSITORY  https://github.com/abseil/abseil-cpp.git
+        URL $ENV{SPM_ABSEIL_TARBALL}
+        URL_HASH SHA256=6e1aee535473414164bf83e4ebc40240dec71a4701f8a642d906e95bea1aea0c
         SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/third_party/abseil-cpp
-        GIT_PROGRESS TRUE
-        GIT_TAG 20260526.0)
+  )
   add_subdirectory(third_party/abseil-cpp)
   if (NOT EXISTS ${CMAKE_CURRENT_SOURCE_DIR}/third_party/absl)
