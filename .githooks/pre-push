#!/usr/bin/env bash
# .githooks/pre-push — local gates before pushing to origin
#
# Catches issues that would otherwise need fix-commits after CI runs:
# - Public-content audit violations (agent abbrevs, hex-secret false positives, PII)
# - Bash syntax errors in modified .sh files
# - Python syntax errors in modified .py files
# - Stale local master (someone pushed while we worked → must rebase first)
# - First-party content changed without a release bump (dev/master pushes only)
#
# Active when scripts/setup-githooks.sh has been run (sets core.hooksPath=.githooks).
# Bypass for emergencies: git push --no-verify (use sparingly; flag in commit msg).

set -euo pipefail

# Under pipefail a pipeline fails when its writer is killed by SIGPIPE, and
# that happens whenever the reader exits before the writer has finished:
# `grep -q` at its first match, `head -1` after one line. Input longer than a
# pipe holds is enough — a long commit message, a long file list. Inside an
# assignment that ended this hook on the spot with no gate result and no
# reason; inside an `if` it turned a match into the wrong answer. So no
# pipeline in this file ends in a reader that stops early: a check that stops
# at its first match reads from a process substitution, whose writer's exit
# status does not decide the result, and a first line is taken with parameter
# expansion.

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# ---- Python interpreter detection (host-portable) ------------------------
# Python invocation is portable across hosts:
#   - Linux/macOS:    python3 (typical)
#   - Windows mingw:  py launcher (Windows installer adds this)
#   - Windows fallback: python (if Python 3 is the only python on PATH)
# The bare `python3` path on Windows often resolves to the MS Store install
# stub, which prompts an install + exits non-zero (caught 2026-05-06 via
# cross-host clone validation; py-compile gate at gate 3 hit the same trap
# again 2026-05-19 from a Windows clone). The detection chain routes around it.
# Computed ONCE at hook start and reused by all gates that need Python.
if python3 --version >/dev/null 2>&1; then
    PY_BIN=python3
elif command -v py >/dev/null 2>&1; then
    PY_BIN=py
elif grep -q "Python 3" < <(python --version 2>&1); then
    PY_BIN=python
else
    PY_BIN=""
fi

# ---- A gate that cannot run refuses the push ----------------------------
# Decided 2026-09-17, replacing the skip-on-missing posture the four
# range-scoped gates below shared. The old comment justified it as "a branch
# predating it"; that is the wrong way round. This hook and the scripts it runs
# live in the SAME checkout, so a script that is not there means this tree was
# modified — and a warning printed during an automated push is read by nobody,
# which makes the check silently absent rather than skipped. The same holds for
# the interpreter: a gate nobody could run has not passed.
#
# Called before each gate, with the script path and the gate's plain name. It
# either returns, meaning the gate can run, or it refuses the push naming what
# is missing and why the push is refused for it.
require_gate_can_run() {
    local script="$1" label="$2"
    if [ ! -f "$script" ]; then
        echo "[pre-push] BLOCK: the $label could not run — $script is missing."
        echo "  Reason: the hook and its gates live in the same checkout, so a missing gate script"
        echo "          means this tree was modified. A check that did not run has not passed."
        echo "  Resolve: restore $script, or push from a tree that carries it."
        exit 1
    fi
    if [ -z "$PY_BIN" ]; then
        echo "[pre-push] BLOCK: the $label could not run — no Python 3 interpreter was found."
        echo "  Reason: $script needs Python 3, and a check that did not run has not passed."
        echo "  Resolve: make Python 3 reachable as python3, py or python on PATH."
        exit 1
    fi
}

# A range gate reads "$REMOTE..$LOCAL". With REMOTE empty that is "..<sha>",
# which git reads as HEAD..<sha> -- an empty range whenever HEAD is the commit
# being pushed -- so the gate prints PASS having read nothing. The baseline
# block further down refuses before any gate runs when it has no baseline;
# this guard makes the same refusal at each range gate, so no later path can
# hand one an empty range. The gates after the stale-branch check skip on an
# empty baseline instead; a skip here would be the same quiet pass again, so
# this guard refuses. Decided 2026-09-22.
require_range_baseline() {
    local label="$1"
    if [ -z "${REMOTE:-}" ]; then
        echo "[pre-push] BLOCK: the $label could not run — this push has no baseline to measure its range from."
        echo "  Reason: the range would be empty, and a check that read nothing has not passed."
        exit 1
    fi
}

# Read the two positional arguments git passes a pre-push hook:
#   $1 = the remote NAME being pushed to (e.g. "origin")
#   $2 = the remote URL being pushed to  (e.g. git@github.com:owner/repo.git)
# Nothing in this hook read either one until 2026-08-25, which is how gate 10
# (the TRACKER anchor) came to write outward for a push at a throwaway local
# remote: it decided on the ref name alone. The NAME is not evidence — any clone
# may name any remote "origin", and the throwaway clone did. The URL is.
# Both are captured here, beside the stdin read, because both are "what git told
# this hook about the push". The multi-ref fan-out below re-invokes this script
# with "$@", so a child invocation receives them unchanged.
PUSH_REMOTE_NAME=${1:-}
PUSH_REMOTE_URL=${2:-}

# Read stdin (pre-push hook receives refs being pushed):
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Captured into PUSH_REFS array so later gates can inspect for force-push to master.
PUSH_REFS=()
while IFS= read -r line; do
    [ -z "$line" ] && continue
    PUSH_REFS+=("$line")
done

echo "[pre-push] running local gates..."

# ---- 0. Force-push HARD-block on master ----------------------------------
# master is sacred. Any push where remote_sha (current origin) is not an
# ancestor of local_sha (about to be pushed) means we're rewriting history
# at master — that's only possible via --force or --force-with-lease.
# HARD BLOCK: we never rewrite published master history.
ZERO="0000000000000000000000000000000000000000"
for refline in "${PUSH_REFS[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha <<< "$refline"
    if [ "$remote_ref" = "refs/heads/master" ] && [ "$remote_sha" != "$ZERO" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            echo "[pre-push] BLOCK: force-push to master detected."
            echo "  remote master at: $remote_sha"
            echo "  local master at:  $local_sha"
            echo "  remote is NOT an ancestor of local — this would rewrite published history."
            echo "  master is sacred; no force-push permitted."
            echo "  If you genuinely need history rewrite (e.g., post-incident scrub),"
            echo "  coordinate with all active agents first AND temporarily remove this gate."
            exit 1
        fi
    fi
done

# ---- 0a. Pushed REF NAMES pass the language categories (fail-closed) ------
# Nothing scanned the ref-name namespace. Every other public surface — file bytes,
# commit subjects, commit bodies — goes through the language categories, but a branch
# name reaches the public remote unread, and seat-named refs did reach both public
# remotes this cycle before a person caught them. A ref name is published exactly like
# the bytes under it.
#
# Placed BEFORE the multi-ref fan-out on purpose: this loop walks PUSH_REFS directly, so
# one pass covers EVERY ref in the push whether or not the fan-out runs, and a child
# invocation re-checking its own single ref is harmless.
#
# DELETIONS ARE EXEMPT, and that is not a softening: a delete arrives with the all-zero
# local sha, publishes nothing, and is the only way to REMOVE a badly-named ref. Gating
# deletions would make the offending refs this gate exists for impossible to clean up.
#
# TAGS ARE INCLUDED as well as branches. The dispatched scope named branch refs; a tag
# name is published to the same public namespace and costs one case arm, so leaving it
# open would be a known silent hole. Called out in the delivery rather than folded in
# quietly.
require_gate_can_run scripts/check-public-language.py "ref-name language gate"
_refname_args=()
for refline in "${PUSH_REFS[@]}"; do
    read -r _l _ls _rref _rs <<< "$refline"
    [ "$_ls" = "$ZERO" ] && continue          # deletion: nothing published
    case "$_rref" in
        refs/heads/*|refs/tags/*) _refname_args+=(--text "$_rref") ;;
    esac
done
if [ "${#_refname_args[@]}" -gt 0 ]; then
    if ! "$PY_BIN" scripts/check-public-language.py --label "pushed ref name" \
             "${_refname_args[@]}"; then
        echo "[pre-push] BLOCK: a pushed ref NAME failed the language gate (see above)"
        echo "  Rule 22: public refs are content-descriptive (feature/<topic>),"
        echo "  never named after a seat, a person, or a dev host."
        echo "  Rename locally, then push the new name:"
        echo "    git branch -m <old> <new> && git push origin <new>"
        exit 1
    fi
fi

# ---- 0b. Multi-ref fan-out (blind spot 3: the push-range under-scan) ------
# The ref loop below stops at the FIRST branch ref it finds (`break`). One push can
# update several branches — `git push origin dev master`, `git push --all`, or any
# two-branch spelling — and every branch ref after the first was then validated by
# nothing at all. Reproduced as a real push before this fix was written: a commit whose
# subject the conventional-commit gate refuses in isolation (exit 1) reached the remote
# untouched when it arrived as the SECOND ref of a two-ref push (exit 0, "all gates PASS").
#
# The fix keeps the single-ref logic below exactly as it is — that logic is well tested and
# carries several hard-won corrections — and instead re-invokes this hook once per branch
# ref, feeding it that one ref on stdin. Each ref therefore gets the complete, unmodified
# gate suite. Fail-closed in the direction the standard requires: EVERY ref must pass, and
# a single refusal refuses the whole push, because git applies a rejected push atomically
# only when --atomic is given and we will not rely on the caller for that.
#
# GIT_PRE_PUSH_SINGLE_REF marks the child invocations so they run the gates directly
# instead of fanning out again. Setting it by hand on a multi-ref push disables the
# fan-out and restores first-ref-only validation — the same effect class as
# `git push --no-verify`, which every pusher already holds; the variable adds no
# bypass a pusher does not have, but it is not a no-op either.
_branch_ref_count=0
for refline in "${PUSH_REFS[@]}"; do
    read -r _l _ls _rref _rs <<< "$refline"
    case "$_rref" in refs/heads/*) _branch_ref_count=$((_branch_ref_count + 1)) ;; esac
done

if [ "$_branch_ref_count" -gt 1 ] && [ -z "${GIT_PRE_PUSH_SINGLE_REF:-}" ]; then
    echo "[pre-push] multi-ref push: $_branch_ref_count branch refs — validating EACH separately"
    _fanout_rc=0
    for refline in "${PUSH_REFS[@]}"; do
        read -r _l _ls _rref _rs <<< "$refline"
        case "$_rref" in refs/heads/*) ;; *) continue ;; esac
        echo "[pre-push] ---- validating $_rref ----"
        if ! GIT_PRE_PUSH_SINGLE_REF=1 bash "$0" "$@" <<< "$refline"; then
            echo "[pre-push] ref $_rref FAILED its gates."
            _fanout_rc=1
        fi
    done
    if [ "$_fanout_rc" -ne 0 ]; then
        echo "[pre-push] BLOCK: at least one ref in this multi-ref push failed its gates."
        exit 1
    fi
    echo "[pre-push] all refs in this multi-ref push PASS"
    exit 0
fi

# ---- Determine the branch being pushed + its validation range ------------
# Gates 2-9 validate the commits THIS push introduces on whatever branch is
# being pushed (master, dev, feature/*) — NOT a hardcoded master range. Per
# branch-model.md the content/syntax gates are identical on every branch. The
# old hardcoded master/origin-master derivation had two bugs on a dev push:
# (a) a drifted local master spuriously blocked it at gate 2, and (b) the dev
# commits were never actually validated (the master range was empty). Gate 0
# (force-block) + gate 10 (anchor) stay master-only by design (they read
# PUSH_REFS directly).
PUSH_BRANCH=""
PUSH_LOCAL=""
PUSH_REMOTE=""
for refline in "${PUSH_REFS[@]}"; do
    read -r _lref local_sha remote_ref remote_sha <<< "$refline"
    case "$remote_ref" in
        refs/heads/*)
            # A ref DELETION arrives with the all-zero local sha — it
            # publishes no content, so there is nothing for the
            # branch-content gates to scan (and a ZERO..X range is not a
            # valid revision range: the first branch-ref delete crashed
            # the language gate fail-closed). Skip it and keep looking
            # for a real branch update in the same push.
            if [ "$local_sha" = "$ZERO" ]; then
                continue
            fi
            PUSH_BRANCH="${remote_ref#refs/heads/}"
            PUSH_LOCAL="$local_sha"
            PUSH_REMOTE="$remote_sha"
            break
            ;;
    esac
done

# Deletion-only (or tag-only) push: no branch content is being published,
# so the range-scoped content gates have nothing to validate — and running
# them with an empty LOCAL produces invalid ranges, not protection. The
# master-only protections above (force-block, anchor) have already run
# against PUSH_REFS directly.
if [ -z "$PUSH_LOCAL" ]; then
    echo "[pre-push] no branch content update in this push (deletion/tag-only) — content gates skipped"
    exit 0
fi

# ---- Which remote is this push actually going to? ------------------------
# git hands a pre-push hook the remote NAME as $1 and the URL as $2, captured
# at the top of this file. Until 2026-09-20 the two places below that ask a
# remote a question -- the baseline the content gates validate against, and
# the stale-branch/rewrite gate -- both asked "origin", whichever remote was
# being pushed to. Resolve it ONCE, here, and let both use it.
#   * a NAME this repository actually has: used as the name, so the remote's
#     tracking refs remain available to the shortcuts below;
#   * otherwise the URL, which git passes as both arguments when a push names
#     no configured remote. A URL has no tracking refs, so the shortcuts are
#     skipped and the more conservative path is taken -- never a narrower one;
#   * with neither (a hook invoked by hand): say so, and keep the historical
#     target rather than inventing one.
if [ -n "$PUSH_REMOTE_NAME" ] && git config --get "remote.$PUSH_REMOTE_NAME.url" >/dev/null 2>&1; then
    TARGET_REMOTE="$PUSH_REMOTE_NAME"
    TARGET_REFS="refs/remotes/$PUSH_REMOTE_NAME"
elif [ -n "$PUSH_REMOTE_URL" ]; then
    TARGET_REMOTE="$PUSH_REMOTE_URL"
    TARGET_REFS=""
else
    echo "[pre-push] no remote named for this push; treating it as a push to origin."
    TARGET_REMOTE="origin"
    TARGET_REFS="refs/remotes/origin"
fi
if [ -n "$TARGET_REFS" ]; then
    TARGET_TRACKING="$TARGET_REFS/$PUSH_BRANCH"
else
    TARGET_TRACKING=""
fi

# The head of <branch> on the remote being pushed to, printed only when the
# object is present locally -- a sha whose commit is absent cannot serve as a
# merge-base and must not be mistaken for one.
#
# "There is no such head" is an ANSWER this function must be able to give, and
# it gives it by printing nothing and returning 0. A remote legitimately has no
# dev branch -- a fresh bare mirror, a backup remote, a push named by URL whose
# dev tip is not among the local objects -- and the caller already treats empty
# output as "no baseline from this branch". Ending on an && chain instead made
# the empty answer a FAILING exit status, and under this file's `set -euo
# pipefail` the caller's `_dev_head=$(target_head_if_present dev)` ended the
# hook on the spot: one line of git's generic wording, no gate result, no
# reason, indistinguishable from a gate refusing. Found 2026-09-21 by the
# second reader of the change that introduced this helper.
target_head_if_present() {
    local _branch="$1" _sha=""
    if [ -n "$TARGET_REFS" ]; then
        _sha=$(git rev-parse --verify --quiet "$TARGET_REFS/$_branch" 2>/dev/null || echo "")
    fi
    if [ -z "$_sha" ]; then
        _sha=$(git ls-remote "$TARGET_REMOTE" "refs/heads/$_branch" 2>/dev/null | awk 'NR==1 {print $1}')
    fi
    if [ -n "$_sha" ] && git cat-file -e "${_sha}^{commit}" 2>/dev/null; then
        printf '%s' "$_sha"
    fi
    return 0
}

# LOCAL/REMOTE drive gates 3-9 (range = merge-base(LOCAL,REMOTE)..LOCAL).
# The gates validate the commits THIS push introduces TO THE REMOTE, so:
#   1. Already-published sha — a ref-alias push (branch rename) or a
#      fast-forward promotion of the published dev tip to master: the exact
#      SHA is already under one of that remote's refs, every commit in it
#      passed these gates on its way there, and the validation range is
#      EMPTY. The gates that judge the push ITSELF still run: 1 (the pushed
#      bytes), 9.5 (the release-validation record on a master push), 10
#      (the ledger anchor). (Found 2026-07-12 renaming the two held feature
#      lanes: the fallback re-scanned the whole published history and halted
#      on a pre-existing, already-landed commit. Until 2026-10-18 this case
#      was asked only for a brand-new branch, so a release promotion whose
#      1,265 commits were all already on the remote's dev was re-judged by
#      gate versions newer than the commits and refused on history that had
#      passed the gate of its day.)
#   2. Genuinely-new branch (remote_sha all-zero, sha not yet on the
#      remote): baseline at the DEEPEST published ancestor —
#      merge-base with origin/dev when at-or-below the branch (covers both
#      a branch off the current dev tip AND one forked from an older dev
#      tip after dev moved on), else merge-base with origin/master. The
#      historical origin/master-tip baseline re-evaluated the whole
#      dev-ahead-of-master history for any dev-side feature branch and
#      halted on pre-existing origin/dev commits the push never introduced
#      (found 2026-07-09 on the first dev-side docs branch).
#
#   Both branches of case 1 and case 2 used to be asked of origin alone, and
#   that is the same defect as the one gate 2 carried, with a quieter effect.
#   Measured 2026-09-20: a branch pushed to origin first and to the second
#   remote afterwards was, on the second push, found "already published"
#   because origin had it -- so the validation range collapsed to empty and
#   two gates that announce themselves by name, the release-note chain gate
#   and the changelog accumulation gate, did not run and said nothing about
#   not running. The second push printed "all gates PASS" having run fewer of
#   them. The question is now asked of the remote being pushed to.
LOCAL="$PUSH_LOCAL"
_published_here=""
if [ -n "$TARGET_REFS" ]; then
    _published_here=$(git branch -r --list "${TARGET_REFS#refs/remotes/}/*" --contains "$PUSH_LOCAL" 2>/dev/null)
fi
if [ -n "$_published_here" ]; then
    # Case 1 is correct to validate nothing -- every commit here already
    # passed these gates on its way to this remote -- but it used to do so
    # without a word, so "all gates PASS" on this path meant the gates
    # driven by the push range had run over nothing. It is now said.
    _published_as=$(printf '%s\n' "$_published_here" | awk 'NF && !found {print $1; found = 1}')
    REMOTE="$PUSH_LOCAL"
    echo "[pre-push] $PUSH_LOCAL is already on $TARGET_REMOTE (contained in $_published_as); the gates driven by the push range have no new commits to validate for this push."
elif [ -z "$PUSH_REMOTE" ] || [ "$PUSH_REMOTE" = "$ZERO" ]; then
    _dev_head=$(target_head_if_present dev)
    _master_head=$(target_head_if_present master)
    _mb_dev=""
    _mb_master=""
    [ -n "$_dev_head" ] && _mb_dev=$(git merge-base "$PUSH_LOCAL" "$_dev_head" 2>/dev/null || echo "")
    [ -n "$_master_head" ] && _mb_master=$(git merge-base "$PUSH_LOCAL" "$_master_head" 2>/dev/null || echo "")
    if [ -n "$_mb_dev" ] && { [ -z "$_mb_master" ] || git merge-base --is-ancestor "$_mb_master" "$_mb_dev" 2>/dev/null; }; then
        REMOTE="$_mb_dev"
    elif [ -n "$_mb_master" ]; then
        REMOTE="$_mb_master"
    else
        # The remote being pushed to shows no dev and no master this
        # checkout can resolve -- a fresh bare mirror, a backup remote, a
        # push named by URL whose tips are not among the local objects.
        # Leaving the baseline empty here would collapse the validation
        # range to nothing and the range-driven gates would go silent,
        # which is the very defect this block was rewritten to end. So the
        # baseline is taken from THIS checkout's own dev, else its master,
        # and the substitution is PRINTED: a narrower baseline is allowed,
        # a quiet one is not.
        _local_dev=$(git rev-parse --verify --quiet refs/heads/dev 2>/dev/null || echo "")
        _local_master=$(git rev-parse --verify --quiet refs/heads/master 2>/dev/null || echo "")
        _mb_local_dev=""
        _mb_local_master=""
        [ -n "$_local_dev" ] && _mb_local_dev=$(git merge-base "$PUSH_LOCAL" "$_local_dev" 2>/dev/null || echo "")
        [ -n "$_local_master" ] && _mb_local_master=$(git merge-base "$PUSH_LOCAL" "$_local_master" 2>/dev/null || echo "")
        if [ -n "$_mb_local_dev" ] && { [ -z "$_mb_local_master" ] || git merge-base --is-ancestor "$_mb_local_master" "$_mb_local_dev" 2>/dev/null; }; then
            REMOTE="$_mb_local_dev"
            echo "[pre-push] $TARGET_REMOTE has no dev or master this checkout can read; the gates are measured from the local dev branch instead."
        elif [ -n "$_mb_local_master" ]; then
            REMOTE="$_mb_local_master"
            echo "[pre-push] $TARGET_REMOTE has no dev or master this checkout can read; the gates are measured from the local master branch instead."
        else
            # Nothing is left to measure from. This branch used to set an
            # empty baseline, print the sentence below and carry on: the
            # three range gates then ran over an empty range and printed
            # PASS, the gates guarded on a baseline did not run at all, and
            # the push ended "all gates PASS" with exit status 0 -- the
            # hook contradicting its own sentence. A gate that cannot run
            # refuses the push; decided 2026-09-22.
            echo "[pre-push] BLOCK: $TARGET_REMOTE has no dev or master this checkout can read, and this checkout has neither either; the gates that need a baseline cannot be measured for this push."
            echo "  Resolve: give this checkout a local dev or master branch that this push descends from -- for example, fetch dev from a remote that has it and run: git branch dev FETCH_HEAD -- then push again."
            exit 1
        fi
    fi
else
    REMOTE="$PUSH_REMOTE"
fi

# ---- 1. Public-content audit (scans the pushed sha via git-show) ---------
# The audit must scan the actually-being-pushed bytes. Reading from the
# working tree (the historical default) was incorrect: a soft-reset+edit
# pattern could pass the audit on working-tree content while the bytes in
# HEAD (what actually gets pushed) carried violations. Caught 2026-05-06.
# Fix: --from-ref reads each file via `git show <ref>:<file>` so the audit
# operates on the same content that's about to be pushed.
#
# That fix pinned the ref to HEAD, which is right only when HEAD happens to
# be the commit being published. It is not, in the form
#   git push origin <some-branch>:dev
# where the ref pushed to dev is <some-branch> and HEAD can be an unrelated
# checkout entirely — the audit then cleared bytes the push was not
# publishing while never reading the bytes it was. A merge landed on dev via
# exactly that spelling on 2026-07-24, which is how this surfaced. The ref is
# now PUSH_LOCAL, the local sha git handed this hook for the branch being
# updated, so the audit reads the published content by construction rather
# than by coincidence. The gate is fail-closed throughout: a violation blocks,
# and since 2026-09-17 a missing script or a missing interpreter blocks too.
#
# Uses PY_BIN computed at hook start (host-portable Python detection).
require_gate_can_run scripts/check-public-content.py "public-content audit"
if ! "$PY_BIN" scripts/check-public-content.py --from-ref "$PUSH_LOCAL"; then
    echo "[pre-push] BLOCK: public-content audit failed (see above)"
    exit 1
fi

# ---- 1b. Public-language gate (fail-closed; PRIVATE term list) ------------
# Range-scoped companion to the audit above: scans ONLY the added lines +
# commit messages THIS push introduces ($REMOTE..$LOCAL), against a term list
# held privately OUTSIDE the repo (never committed). Fail-closed BOTH ways — a
# term hit blocks, and a missing/unreadable/empty list blocks with a loud error
# naming the private path (absence is never a silent bypass). The predecessor
# left short collision-prone tokens to contextual-only matching, which a bare
# token evaded; this gate matches word-boundary with span-aware, in-code
# exemptions. Since 2026-08-25 the added lines of a file are matched in runs of
# consecutive lines joined by one space, so a two-word term split by a line wrap
# is caught; the report names the line the match starts on. The
# security-critical input is the private list, which the script itself fails
# closed on; since 2026-09-17 a missing script or interpreter fails closed here
# too, so the gate is never absent without saying so.
require_gate_can_run scripts/check-public-language.py "public-language gate"
require_range_baseline "public-language gate"
if ! "$PY_BIN" scripts/check-public-language.py --range "$REMOTE..$LOCAL"; then
    echo "[pre-push] BLOCK: public-language gate failed (see above)"
    exit 1
fi

# ---- 1c. Writing-register gate (two tiers; decided 2026-08-16) ------------
# Range-scoped like 1b: scans ONLY the prose zones of the lines this push
# adds (in runs of consecutive lines joined by one space, so a pattern split by
# a line wrap is caught; the report names the line the match starts on), plus
# the range's non-merge commit messages. The narrow tier refuses
# (machine-assistant self-narration phrasing); the broad tier prints
# advisory lines and never refuses on its own. Exclusion set is the
# committed config/register-gate-exclusions.txt (the script fails loudly if
# it is missing — an undefined exclusion set is never a silent wider scan).
# A missing script or interpreter blocks the push, matching the gates above.
require_gate_can_run scripts/check-register.py "writing-register gate"
require_range_baseline "writing-register gate"
if ! "$PY_BIN" scripts/check-register.py --range "$REMOTE..$LOCAL"; then
    echo "[pre-push] BLOCK: writing-register gate failed (see above)"
    exit 1
fi

# ---- 1d. License-spelling gate (decided 2026-09-17) ----------------------
# Range-scoped like 1b and 1c: the project's own voice spells the license
# word one way, in the lines this push adds and in the range's commit
# messages. Every upstream identifier that keeps the other spelling is
# exempted BY NAME inside the script (file + marker + reason); a stale
# exemption is a setup error there, never a pass. The suite runs the same
# gate over the whole tree; this hook is the only place the commit-message
# surface is reachable before a push. A missing script or interpreter blocks
# the push, matching the gates above.
require_gate_can_run scripts/check-license-spelling.py "license-spelling gate"
require_range_baseline "license-spelling gate"
if ! "$PY_BIN" scripts/check-license-spelling.py --range "$REMOTE..$LOCAL"; then
    echo "[pre-push] BLOCK: license-spelling gate failed (see above)"
    exit 1
fi

# ---- 2. Stale-branch check (the pushed branch vs its OWN remote) ----------
# Require the local branch being pushed to be at-or-ahead of its counterpart
# ON THE REMOTE THIS PUSH IS GOING TO, catching the "remote moved while we
# worked -> push rejected" loop here with a clear message. A brand-new branch
# has no remote head to be stale against, so the check is skipped for it.
#
# WHICH REMOTE (corrected 2026-09-20). Until this date every question below
# was addressed to origin, whatever remote was being pushed to: it asked
# origin whether the branch existed, fetched origin, and compared against
# refs/remotes/origin/<branch>. This project publishes to two remotes, and on
# the second one that is not a wrong label, it is a hole. Measured that day:
# push a branch to both remotes, rewrite it, declare the rewrite and push it
# to the first; the local head now equals origin/<branch>, so the divergence
# arm below was never entered, "all gates PASS" was printed, and a forced push
# overwrote the second remote's history with no declaration and no warning.
# The same substitution makes a branch that is BEHIND the second remote look
# current, so a forced push rewinds it. git hands this hook the remote NAME as
# $1 and the URL as $2 -- both are captured at the top of this file for gate
# 10 -- and this gate now uses them.
#
# WHICH SHA. The comparison head is read from a FRESH ls-remote of that remote
# rather than from any local ref. A remote reached by URL has no tracking refs
# at all, and a tracking ref for a named remote is only as current as the last
# fetch; the advertised sha is the remote's own answer. The fetch below is
# still required, because merge-base needs the object present locally.
#
# Fail-closed posture (per §6 C1 review): if the remote cannot be reached or
# the object cannot be obtained, block rather than silently pass against a
# cached ref; the explicit override env var remains for genuinely-offline
# scenarios, and it now says which remote it is standing in for.
if [ -n "$PUSH_BRANCH" ] && [ -n "$PUSH_REMOTE" ] && [ "$PUSH_REMOTE" != "$ZERO" ]; then
    # Brand-new branch vs unreachable remote are DIFFERENT facts. `git fetch` returns
    # 128 for both, so the block below used to fire on every first push of a new
    # branch and pointed the pusher at network/auth (all fine) and at the offline
    # override (a false premise when the remote is reachable). Distinguish them
    # first: ls-remote --exit-code returns 2 when the remote answered and the ref is
    # absent -- that is the brand-new case, and the staleness check has nothing to
    # compare against, so it is skipped with a named line. Any other non-zero
    # (unreachable, auth) keeps the fail-closed BLOCK. The same call carries the
    # advertised sha, so the remote is asked once and answers both questions.
    if LSREMOTE_OUT=$(git ls-remote --exit-code "$TARGET_REMOTE" "refs/heads/$PUSH_BRANCH" 2>/dev/null); then
        LSREMOTE_RC=0
    else
        LSREMOTE_RC=$?   # 2 = remote answered, ref absent; anything else = unreachable/auth
        LSREMOTE_OUT=""
    fi
    if [ "$LSREMOTE_RC" = "2" ]; then
        echo "[pre-push] stale-branch check: $TARGET_REMOTE has no $PUSH_BRANCH yet (brand-new branch) — nothing to be stale against; skipped."
        REMOTE_HEAD=""
    else
        REMOTE_HEAD=$(printf '%s\n' "$LSREMOTE_OUT" | awk 'NR==1 {print $1}')
        if ! git fetch "$TARGET_REMOTE" "$PUSH_BRANCH" --quiet 2>/dev/null; then
            if [ "${GIT_PRE_PUSH_SKIP_FETCH:-0}" = "1" ]; then
                # The override says "carry on without a fresh fetch". What it
                # can carry on WITH depends on whether this checkout has a
                # cached head for that remote at all: a remote named by URL has
                # no tracking refs, so there is nothing to compare against and
                # the staleness and rewrite checks do not run. Saying
                # "continuing against <remote>" in that case would describe a
                # comparison that is not happening, which is the same silence
                # this file was changed to end -- so the two cases say
                # different things.
                if [ -n "$TARGET_TRACKING" ]; then
                    REMOTE_HEAD=$(git rev-parse "$TARGET_TRACKING" 2>/dev/null || echo "")
                else
                    REMOTE_HEAD=""
                fi
                if [ -n "$REMOTE_HEAD" ]; then
                    echo "[pre-push] WARN: git fetch failed; continuing against $TARGET_REMOTE's cached $PUSH_BRANCH ($REMOTE_HEAD) per GIT_PRE_PUSH_SKIP_FETCH=1 override."
                else
                    echo "[pre-push] WARN: git fetch failed and this checkout holds no cached $PUSH_BRANCH for $TARGET_REMOTE, so the stale-branch and rewrite checks CANNOT RUN for this push (GIT_PRE_PUSH_SKIP_FETCH=1 override)."
                fi
            else
                echo "[pre-push] BLOCK: git fetch $TARGET_REMOTE $PUSH_BRANCH failed."
                echo "  Stale-branch check requires a fresh $PUSH_BRANCH from $TARGET_REMOTE — cannot run on cached refs."
                echo "  Investigate: network connectivity, remote auth, SSH agent state."
                echo "  Override (only when the remote is unreachable AND local is confirmed current):"
                echo "    GIT_PRE_PUSH_SKIP_FETCH=1 git push $TARGET_REMOTE $PUSH_BRANCH"
                exit 1
            fi
        fi
    fi
    # The advertised sha is only usable if the object is here; a check that
    # cannot run has not passed, so an absent object blocks rather than skips.
    if [ -n "$REMOTE_HEAD" ] && ! git cat-file -e "${REMOTE_HEAD}^{commit}" 2>/dev/null; then
        echo "[pre-push] BLOCK: $TARGET_REMOTE says $PUSH_BRANCH is at $REMOTE_HEAD,"
        echo "  but that commit is not in this repository even after fetching it, so the"
        echo "  stale-branch and rewrite checks cannot be evaluated against it."
        echo "  Investigate: a partial/filtered clone, or a remote rewriting under the push."
        exit 1
    fi
    if [ -n "$REMOTE_HEAD" ] && [ "$PUSH_LOCAL" != "$REMOTE_HEAD" ]; then
        BASE2=$(git merge-base "$PUSH_LOCAL" "$REMOTE_HEAD" 2>/dev/null || echo "")
        if [ "$BASE2" = "$PUSH_LOCAL" ]; then
            echo "[pre-push] BLOCK: local $PUSH_BRANCH is behind $TARGET_REMOTE's $PUSH_BRANCH."
            echo "  Remote at: $REMOTE_HEAD"
            echo "  Local at:  $PUSH_LOCAL"
            echo "  Rebase: git pull --rebase $TARGET_REMOTE $PUSH_BRANCH"
            exit 1
        elif [ -n "$BASE2" ] && [ "$BASE2" != "$REMOTE_HEAD" ]; then
            # An authorized history rewrite of one's own non-protected branch
            # (e.g. a sanctioned message-only rebase) is divergence by
            # definition; without an expression for it here, the only route
            # past this gate was --no-verify — which stands down every gate at
            # once, exactly the outcome the gate set exists to prevent (decided
            # 2026-07-24). The hook cannot see push flags, so the lease cannot
            # be asserted here: the pusher declares intent explicitly instead,
            # every other gate still runs, and the push command itself should
            # carry --force-with-lease for the concurrency protection this
            # gate approximates. master and dev are never rewritable, and that
            # is true of every remote, not only the one called origin.
            case "$PUSH_BRANCH" in
                master|dev) ALLOW_REWRITE=0 ;;
                *) ALLOW_REWRITE="${GIT_PRE_PUSH_ALLOW_REWRITE:-0}" ;;
            esac
            if [ "$ALLOW_REWRITE" = "1" ]; then
                echo "[pre-push] WARN: declared rewrite of $PUSH_BRANCH on $TARGET_REMOTE accepted (GIT_PRE_PUSH_ALLOW_REWRITE=1)."
                echo "  Old remote head: $REMOTE_HEAD"
                echo "  New local head:  $PUSH_LOCAL"
                echo "  All remaining gates still apply. Push with --force-with-lease."
            else
                echo "[pre-push] BLOCK: local $PUSH_BRANCH and $TARGET_REMOTE's $PUSH_BRANCH have diverged."
                echo "  Remote at: $REMOTE_HEAD"
                echo "  Local at:  $PUSH_LOCAL"
                echo "  Resolve: git pull --rebase $TARGET_REMOTE $PUSH_BRANCH (resolve conflicts)"
                if [ "$PUSH_BRANCH" != "master" ] && [ "$PUSH_BRANCH" != "dev" ]; then
                    echo "  Authorized rewrite of this branch: GIT_PRE_PUSH_ALLOW_REWRITE=1 git push --force-with-lease $TARGET_REMOTE $PUSH_BRANCH"
                fi
                exit 1
            fi
        fi
    fi
elif [ -n "$PUSH_BRANCH" ]; then
    # git reports an all-zero remote sha for a branch THIS remote does not have
    # yet, which is a per-remote fact and the one case with nothing to compare
    # against. It is named rather than passed over in silence: a reader of a
    # second push has to be able to see which remote the check was made about.
    echo "[pre-push] stale-branch check: $TARGET_REMOTE has no $PUSH_BRANCH yet (brand-new branch) — nothing to be stale against; skipped."
fi

# ---- 3. Syntax checks on modified files in to-be-pushed commits ---------
# The bytes checked are the pushed ref's own (git show <LOCAL>:<path>), never
# the current checkout's. Before 2026-10-08 the two loops tested [ -f "$f" ]
# and linted the working-tree path: a ref that was not checked out had its
# added files skipped as absent and its modified files checked at unrelated
# bytes, so an invalid file reached the remote from an off-HEAD lane while the
# same branch blocked when checked out (a second reader's true positive,
# 2026-10-08).
# The changed paths are enumerated as NUL-delimited raw bytes (git diff -z)
# and read with read -d '': the earlier newline-delimited `git diff
# --name-only` printed Git's DISPLAY form, which quotes a name holding a
# non-ASCII byte, a quote, a backslash or a control character
# ("caf\303\251.py", "broken\nmodule.py"), so the quoted token ended in a
# double quote, matched neither *.py nor *.sh, and an invalid file under such
# a name passed every gate and reached the remote (a second reader's true
# positive, 2026-10-08). An enumeration that fails blocks instead of passing
# an empty list; the mode look-up takes the path literally; a name in a
# BLOCK line is printed shell-quoted so the line stays one line.
# Every changed path present at the tip is enumerated (--diff-filter=d:
# deletions alone excluded): the earlier AM filter dropped a renamed, copied
# or type-changed destination, so an invalid .py reached by a rename, or a
# Python-named symlink replaced by an invalid regular file, was never linted
# and reached the remote (a second reader's true positives, 2026-10-08).
# A Python- or shell-named symbolic link is linted THROUGH its target: the
# bytes the link resolves to inside the pushed ref's tree are checked as the
# link's kind, whether the link or its target changed in the range. Before
# 2026-10-09 a link entry was skipped outright and its target linted only if
# the target's own name ended in .py or .sh, so a link named like a module
# whose target held invalid Python reached the remote with every gate
# passing (a second reader's true positive, 2026-10-09). A link whose target
# is absolute, leaves the tree, dangles, or is not a regular file there
# BLOCKS: its bytes cannot be checked, and a check that did not run has not
# passed. The target is read as its exact bytes, a trailing newline kept:
# the first form of this gate read it through a command substitution, which
# drops trailing newlines, so a link whose target name ended in a newline
# resolved to nothing, was named in a note and passed while the file it
# pointed at held invalid Python (a second reader's true positive,
# 2026-10-09); and the mode look-up read the tree record as a line, so a
# newline inside a target's path left the mode unmatched and the link
# unresolved (a second reader's true positive on the sibling hook, 2026-10-09).
# The target is resolved against the pushed tree component by component: a
# component followed by anything must be a directory at the ref, so `..` is
# taken only out of a directory that exists there — before this it was
# cancelled lexically, and `missing/../x` or `file/../x` resolved to `x` while
# the link itself dangled (a second reader's true positive, 2026-10-09). The
# base's map of script-named links to their targets is carried into the range:
# a link that resolved at the base and no longer does at the pushed ref BLOCKS
# even when the push never touched the link — only its target was deleted,
# renamed or replaced by something that is not a regular file; before this such
# a link simply dropped out of the map and passed (a second reader's true
# positive, 2026-10-09). A link that did not resolve at the base either is
# inherited and stays non-blocking unless the push touches it. The link's own
# parent is taken by parameter expansion: through $(dirname) a parent whose
# name ends in a newline lost that byte and the target was resolved under a
# decoy of the same name (a second reader's true positive, 2026-10-09). A link
# whose blob holds a NUL is refused from a file before any variable carries its
# bytes: a substitution dropped the NUL and a different target was linted (a
# second reader's true positive, 2026-10-09). A link the push itself changed is
# judged in the change set with its own reason, never as one the push did not
# touch; its membership is compared whole in the shell, never as a grep
# pattern, and the NUL count is read only with both statuses of the pipeline
# that took it (two second-reader true positives on the first forms,
# 2026-10-09). A link whose blob cannot be read at either ref blocks at once
# instead of dropping out of the maps (a second reader's true positive,
# 2026-10-09); so does a path whose mode cannot be looked up, which the first
# form read as an absent path; the block's hex display is bounded to the blob's
# first 64 bytes (two second-reader true positives, 2026-10-09).
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    LOCAL_SHORT=$(git rev-parse --short "$LOCAL")
    SYNTAX_TMP=$(mktemp -d 2>/dev/null) || { echo "[pre-push] BLOCK: no scratch directory for the syntax checks (mktemp failed)."; exit 1; }
    if ! git diff --name-only -z --diff-filter=d "$BASE" "$LOCAL" > "$SYNTAX_TMP/changed.z" 2>/dev/null; then
        echo "[pre-push] BLOCK: cannot enumerate the files changed in $(git rev-parse --short "$BASE" 2>/dev/null || echo "$BASE")..$LOCAL_SHORT for the syntax checks (git diff failed)."
        rm -rf "$SYNTAX_TMP"; exit 1
    fi
    if ! git ls-tree -r -z "$LOCAL" > "$SYNTAX_TMP/tree.z" 2>/dev/null; then
        echo "[pre-push] BLOCK: cannot list the tree at $LOCAL_SHORT for the syntax checks (git ls-tree failed)."
        rm -rf "$SYNTAX_TMP"; exit 1
    fi

    # The kind a path is linted as, by its name and this tree's exclusions;
    # nothing when it is not linted.
    lint_kind() {
        case "$1" in
            *.sh) printf sh ;;
            *.py) case "$1" in */__pycache__/*|*/.venv/*|*/build/*) return 1 ;; esac; printf py ;;
            *) return 1 ;;
        esac
    }
    # The mode of a path at a ref (120000 = a symbolic link, 040000 = a
    # directory), or nothing: the first six bytes of git's record, taken from
    # the record read WHOLE into the shell — never a line of it (a newline
    # inside the path is written C-quoted by git ls-tree without -z, and the
    # first six bytes are the mode whatever the path holds), and never through
    # a reader that stops early: the earlier form piped the NUL-terminated
    # record through head -c 6, the pipeline shape this repository's
    # preflight test (tests/preflight/test_pre_push_reads_long_input_whole.py)
    # refuses in this file, because under pipefail a writer whose reader has
    # gone ends the pipeline with SIGPIPE (2026-10-10).
    # Printed only when git exited zero; otherwise nothing is printed and the
    # look-up fails with status 4, so a caller never reads a failed look-up as
    # "no such path" — the first form consumed the output alone, and a failing
    # look-up made a resolving link vanish from the maps (a second reader's
    # true positive, 2026-10-09). An absent path is a successful look-up with
    # an empty record. One command, one instrument: the block that follows
    # names git ls-tree and the repository's recovery.
    mode_at() { # <ref> <path>
        local out
        out=$(git --literal-pathspecs ls-tree "$1" -- "$2" 2>/dev/null) || return 4
        printf '%s' "${out:0:6}"
    }
    mode_at_ref() { mode_at "$LOCAL" "$1"; }
    # The exact bytes a symbolic link's blob holds at a ref (its target as
    # written, a trailing newline kept), or failure when it cannot be read or
    # holds a NUL. The blob is read into a FILE first and refused there when
    # it holds a NUL: no shell variable can carry one, so a command
    # substitution dropped it (with a warning) and the bytes that remained — a
    # different target, one a filesystem could hold — were resolved and linted
    # in the link's place, and the push passed (a second reader's true
    # positive, 2026-10-09). The change set reads the same file first, so the
    # gate blocks such a link with that reason before any variable sees its
    # bytes; a count that could not be taken is a block of its own, naming the
    # counting tools, never the link. The NUL count comes from nul_count_of, which carries both
    # statuses of its pipeline out with the number: the first form read the
    # pipeline's output alone, so a failed tr printed 0 and a NUL-bearing blob
    # passed (a second reader's true positive, 2026-10-09); a count that could
    # not be taken is never read as zero.
    nul_count_of() { # <file> : prints the count of NUL bytes, only when tr and wc -c both exited zero; nothing otherwise
        local out
        out=$(tr -cd '\000' < "$1" | wc -c; printf ' %s %s' "${PIPESTATUS[0]}" "${PIPESTATUS[1]}") || return 1
        set -- $out
        [ $# -eq 3 ] && [ "$2" = 0 ] && [ "$3" = 0 ] || return 1
        case "$1" in ''|*[!0-9]*) return 1 ;; esac
        printf '%s' "$1"
    }
    link_target_bytes_at() { # <ref> <link path> : 1 when the blob holds a NUL; 2 when it cannot be read; 3 when its NUL count could not be taken
        local raw n
        git show "$1:$2" > "$SYNTAX_TMP/link.bytes" 2>/dev/null || return 2
        n=$(nul_count_of "$SYNTAX_TMP/link.bytes") || return 3
        [ "$n" -eq 0 ] || return 1
        raw=$(cat "$SYNTAX_TMP/link.bytes" && printf x) || return 2
        printf '%s' "${raw%x}"
    }
    link_target_bytes() { link_target_bytes_at "$LOCAL" "$1"; }
    # The in-tree path a symbolic link resolves to at a ref, when its target is
    # relative, every directory it walks through is a directory of that tree,
    # it never leaves the tree, and the file it names is a regular file there;
    # nothing otherwise. The walk is made against the tree, not the text: a
    # component that is followed by anything must be a directory at the ref,
    # so a `..` is taken only out of a directory that exists there, and
    # `missing/../x` or `file/../x` resolves to nothing instead of to `x`
    # (before this a `..` cancelled its left-hand component lexically, so a
    # dangling link passed while an unrelated file was linted under its name —
    # a second reader's true positive, 2026-10-09). A link to a link, or
    # through a link, is not followed. Returns 2 when the link's blob cannot
    # be read at the ref, 3 when its NUL count could not be taken, 4 when a
    # mode could not be listed (git) and 5 when a listed mode could not be
    # read (head), so a caller never mistakes a link it could not examine for
    # one that resolves to nothing (four second-reader true positives,
    # 2026-10-09); block_by_status names each.
    link_target_in_tree_at() { # <ref> <link path>
        local ref="$1" link="$2" target dir out part i n st m
        local -a parts
        target=$(link_target_bytes_at "$ref" "$link" && printf x); st=$?
        [ "$st" -eq 0 ] || return "$st"
        target=${target%x}
        # Empty or absolute: not in the tree. Ending in a slash, /. or /..: the
        # target names a directory, never a regular file (the split below would
        # otherwise drop the trailing part and resolve a file the link does not
        # reach — a second reader's true positive, 2026-10-09).
        case "$target" in ''|/*|*/|*/.|*/..) return 1 ;; esac
        # The link's parent by parameter expansion, never a substitution: a
        # parent directory whose name ends in a newline would lose that byte
        # through $(dirname), and the target was resolved under the wrong
        # parent — a valid decoy linted while the real target held invalid
        # Python (a second reader's true positive, 2026-10-09).
        case "$link" in */*) dir=${link%/*} ;; *) dir="" ;; esac
        out="$dir"
        # The target split on slashes into an array and read to its end (the
        # delimiter is NUL, which the bytes never hold), so a newline inside a
        # component is kept as part of it.
        IFS='/' read -r -d '' -a parts < <(printf '%s' "$target") || true
        n=${#parts[@]}
        for ((i = 0; i < n; i++)); do
            part=${parts[i]}
            case "$part" in
                ''|.) ;;
                ..) [ -n "$out" ] || return 1
                    if [[ "$out" == */* ]]; then out="${out%/*}"; else out=""; fi ;;
                *)  out="${out:+$out/}$part"
                    # A component that is followed by anything is walked through: a directory of the tree, or nothing resolves.
                    if ((i < n - 1)); then m=$(mode_at "$ref" "$out") || return $?; [ "$m" = 040000 ] || return 1; fi ;;
            esac
        done
        [ -n "$out" ] || return 1
        m=$(mode_at "$ref" "$out") || return $?
        case "$m" in 100644|100755) printf '%s' "$out" ;; *) return 1 ;; esac
    }
    link_target_in_tree() { link_target_in_tree_at "$LOCAL" "$1"; }
    # Whether a path is one of the NUL-delimited records of changed.z, compared
    # whole in the shell — never as a grep pattern: grep splits a pattern on
    # newlines whatever -z does to its records, so a newline-bearing path never
    # matched and the push was said not to have touched it (a second reader's
    # true positive, 2026-10-09).
    in_changed_set() { # <path>
        local entry
        while IFS= read -r -d '' entry; do [ "$entry" = "$1" ] && return 0; done < "$SYNTAX_TMP/changed.z"
        return 1
    }
    # Lint one blob of the pushed ref as Python or Bash, naming what was pushed.
    lint_blob_at_ref() { # <py|sh> <path at the ref> <name shown>
        local kind="$1" path="$2" shown="$3"
        if ! git show "$LOCAL:$path" > "$SYNTAX_TMP/check.$kind" 2>/dev/null; then
            echo "[pre-push] BLOCK: cannot read $shown at $LOCAL_SHORT for its syntax check."
            rm -rf "$SYNTAX_TMP"; exit 1
        fi
        if [ "$kind" = sh ]; then
            if ! bash -n "$SYNTAX_TMP/check.sh" 2>/dev/null; then
                echo "[pre-push] BLOCK: bash syntax error in $shown at $LOCAL_SHORT (bash -n reports it as check.sh):"
                bash -n "$SYNTAX_TMP/check.sh" || true
                rm -rf "$SYNTAX_TMP"; exit 1
            fi
        else
            if [ -z "$PY_BIN" ]; then
                echo "[pre-push] BLOCK: the Python syntax check could not run — no Python 3 interpreter was found."
                echo "  Reason: $shown is being pushed unchecked, and a check that did not run has not passed."
                echo "  Resolve: make Python 3 reachable as python3, py or python on PATH."
                rm -rf "$SYNTAX_TMP"; exit 1
            fi
            if ! "$PY_BIN" -m py_compile "$SYNTAX_TMP/check.py" 2>/dev/null; then
                echo "[pre-push] BLOCK: Python syntax error in $shown at $LOCAL_SHORT (py_compile reports it as check.py):"
                "$PY_BIN" -m py_compile "$SYNTAX_TMP/check.py" || true
                rm -rf "$SYNTAX_TMP"; exit 1
            fi
        fi
    }

    # A Python- or shell-named symbolic link whose bytes cannot be checked
    # through the pushed tree blocks the push, naming the target as written.
    block_unchecked_link() { # <link path at the ref> [<why, in words>]
        local raw shown n
        if ! git show "$LOCAL:$1" > "$SYNTAX_TMP/link.bytes" 2>/dev/null; then
            shown="(unreadable: its blob cannot be read at $LOCAL_SHORT)"
        elif ! n=$(nul_count_of "$SYNTAX_TMP/link.bytes"); then
            shown="(its bytes could not be counted: tr or wc -c failed)"
        elif [ "$n" -gt 0 ]; then
            shown="$(od -An -tx1 -v -N 64 -w64 "$SYNTAX_TMP/link.bytes" | sed 's/^ *//; s/ *$//') ($(wc -c < "$SYNTAX_TMP/link.bytes") bytes, the first 64 shown in hex: they hold a NUL, which no path can hold)"
        else
            raw=$(link_target_bytes "$1" && printf x) || raw="x"
            shown=$(printf '%q' "${raw%x}")
        fi
        echo "[pre-push] BLOCK: $(printf '%q' "$1") at $LOCAL_SHORT is a symbolic link named as a module whose target $shown is not a regular file inside the pushed tree (absolute, outside the tree, missing, reached through a component that is not a directory there, or itself a link)${2:+ — $2}."
        echo "  Reason: the bytes it stands for cannot be checked at this ref, and a check that did not run has not passed."
        echo "  Resolve: point the link at a regular file inside the tree, or replace it with the file itself."
        rm -rf "$SYNTAX_TMP"; exit 1
    }
    # A Python- or shell-named path whose blob or mode cannot be read at a ref
    # blocks the push at once: before this the two maps treated such a link as
    # one that resolves to nothing, so it dropped out silently and a change to
    # its target passed unlinted while an unreadable regular file blocked (a
    # second reader's true positive, 2026-10-09); a failed mode look-up read as
    # an absent path the same way (a second reader's true positive, 2026-10-09).
    block_unreadable_link() { # <path> <ref, shown> <what failed>
        echo "[pre-push] BLOCK: $(printf '%q' "$1") is named as a module and cannot be read at $2 ($3 failed), so what it stands for cannot be checked."
        echo "  Reason: a check that did not run has not passed."
        echo "  Resolve: repair the repository's objects (git fsck; re-fetch or re-create the link) and push again."
        rm -rf "$SYNTAX_TMP"; exit 1
    }
    # A Python- or shell-named symbolic link whose blob could not be COUNTED
    # (tr or wc -c failed) blocks with its own recovery: the link is not at fault
    # and changing it cannot clear the block — before this the uncounted case
    # was blocked as an unchecked link and the user was told to change the link
    # (a second reader's true positive, 2026-10-09).
    block_uncounted_link() { # <path> <ref, shown>
        echo "[pre-push] BLOCK: $(printf '%q' "$1") at $2 is a symbolic link named as a module whose bytes could not be counted (tr or wc -c failed), so whether it holds a NUL is not known."
        echo "  Reason: a check that did not run has not passed."
        echo "  Resolve: repair the counting tools on PATH (tr and wc -c) and push again; the link itself is not at fault."
        rm -rf "$SYNTAX_TMP"; exit 1
    }
    # The block for a mode look-up that failed (mode_at's status 4: git could
    # not list the entry, the one instrument the look-up has since the
    # six-byte reader left it). Every failure blocks; none passes.
    block_mode_status() { # <status> <path> <ref, shown>
        block_unreadable_link "$2" "$3" "git ls-tree"
    }
    # The block for a link the resolver could not examine, by the status it
    # returned (2 the blob unreadable, 3 its count not taken, 4 a mode not
    # listed by git). Status 1 — the link resolves to nothing — is not a block
    # here and is the caller's to judge; any other status blocks as a look-up
    # that did not run, never passes.
    block_by_status() { # <status> <path> <ref, shown>
        case "$1" in
            1) ;;
            2) block_unreadable_link "$2" "$3" "git show" ;;
            3) block_uncounted_link "$2" "$3" ;;
            4) block_mode_status "$1" "$2" "$3" ;;
            *) block_unreadable_link "$2" "$3" "a look-up with the unexpected status $1" ;;
        esac
    }
    # Script-named symbolic links at the pushed ref and their in-tree targets,
    # so a target whose bytes changed is linted under the link's name even
    # when the link itself did not change in the range. A link that resolves
    # to nothing has no in-tree target a changed path could be, so it is
    # simply absent from this map; it blocks below when the link itself is in
    # the pushed change set (its introduction or change), or when it resolved
    # at the base of the range and no longer does (the base's map, next),
    # never for a push that did not touch it or its target.
    : > "$SYNTAX_TMP/links.z"
    while IFS= read -r -d '' entry; do
        [ "${entry:0:6}" = 120000 ] || continue
        lnk="${entry#*	}"
        lint_kind "$lnk" >/dev/null || continue
        if tgt=$(link_target_in_tree "$lnk" && printf x); then tgt=${tgt%x}; printf '%s\0%s\0' "$tgt" "$lnk" >> "$SYNTAX_TMP/links.z"; else block_by_status $? "$lnk" "$LOCAL_SHORT"; fi
    done < "$SYNTAX_TMP/tree.z"
    # The base's map too: a script-named link that resolved to a regular file
    # at the base of the range and is still a link at the pushed ref must still
    # resolve there, or this push broke it — its target deleted, renamed, or
    # replaced by something that is not a regular file — and the bytes it
    # stands for can no longer be checked. Before this a change that touched
    # only the target took the link out of the map above, and a link the push
    # itself did not change was never presented to the block (a second
    # reader's true positive, 2026-10-09). A link that did not resolve at the
    # base either is inherited, not broken here, and stays non-blocking unless
    # the push touches it; a link the push removed or replaced is in the
    # change set and is handled there.
    if ! git ls-tree -r -z "$BASE" > "$SYNTAX_TMP/tree-base.z" 2>/dev/null; then
        echo "[pre-push] BLOCK: cannot list the tree at $(git rev-parse --short "$BASE" 2>/dev/null || echo "$BASE") for the syntax checks (git ls-tree failed)."
        rm -rf "$SYNTAX_TMP"; exit 1
    fi
    while IFS= read -r -d '' entry; do
        [ "${entry:0:6}" = 120000 ] || continue
        lnk="${entry#*	}"
        lint_kind "$lnk" >/dev/null || continue
        link_target_in_tree_at "$BASE" "$lnk" >/dev/null || { block_by_status $? "$lnk" "$(git rev-parse --short "$BASE" 2>/dev/null || echo "$BASE") (the base of this push)"; continue; }
        m=$(mode_at_ref "$lnk") || block_mode_status $? "$lnk" "$LOCAL_SHORT"
        [ "$m" = 120000 ] || continue
        # A link the push itself changed is judged in the change set below,
        # with its own reason; this map speaks only for links the push did not
        # touch (the first form named every broken link as untouched; the
        # second gave grep the path as a pattern, which it splits on newlines).
        in_changed_set "$lnk" && continue
        link_target_in_tree "$lnk" >/dev/null && continue
        block_unchecked_link "$lnk" "it resolved to a regular file at the base of this push ($(git rev-parse --short "$BASE" 2>/dev/null || echo "$BASE")) and this push broke that without touching the link"
    done < "$SYNTAX_TMP/tree-base.z"

    while IFS= read -r -d '' f; do
        [ -z "$f" ] && continue
        if kind=$(lint_kind "$f"); then
            m=$(mode_at_ref "$f") || block_mode_status $? "$f" "$LOCAL_SHORT"
            if [ "$m" = 120000 ]; then
                # A blob that holds a NUL is refused here, before any variable
                # carries its bytes (link_target_bytes_at says why); a blob that
                # could not be counted is refused with its own recovery; a blob
                # that cannot be read falls to the resolver's block below.
                if git show "$LOCAL:$f" > "$SYNTAX_TMP/link.bytes" 2>/dev/null; then
                    n=$(nul_count_of "$SYNTAX_TMP/link.bytes") || block_uncounted_link "$f" "$LOCAL_SHORT"
                    [ "$n" -eq 0 ] || block_unchecked_link "$f" "its blob holds a NUL byte, which no path can hold and no shell variable can carry, so the target it names is not one this gate can check"
                fi
                # The resolved path is carried through the substitution with a
                # sentinel byte, so a name that ends in a newline keeps it.
                if tgt=$(link_target_in_tree "$f" && printf x); then
                    tgt=${tgt%x}
                    lint_blob_at_ref "$kind" "$tgt" "$(printf '%q' "$f") (a symbolic link to $(printf '%q' "$tgt"))"
                else
                    block_unchecked_link "$f"
                fi
            else
                lint_blob_at_ref "$kind" "$f" "$(printf '%q' "$f")"
            fi
        fi
        # A changed path that a script-named link resolves to is linted as the link's kind too.
        while IFS= read -r -d '' tgt && IFS= read -r -d '' lnk; do
            [ "$tgt" = "$f" ] || continue
            m=$(mode_at_ref "$f") || block_mode_status $? "$f" "$LOCAL_SHORT"
            [ "$m" = 120000 ] && continue
            lint_blob_at_ref "$(lint_kind "$lnk")" "$f" "$(printf '%q' "$f") (the target of the symbolic link $(printf '%q' "$lnk"))"
        done < "$SYNTAX_TMP/links.z"
    done < "$SYNTAX_TMP/changed.z"
    rm -rf "$SYNTAX_TMP"
fi

# ---- 4. Commit-message-to-diff scope gate --------------------------------
# For each commit in the push range, files with >THRESHOLD lines changed
# must appear in the commit message body. Catches under-documented commits
# like 8fc25f5 (2026-05-06: shipped 138 lines of mirror-upload under a
# 1-line-tweak commit message). Three-lane fleet consensus on this gate.
# Override: `NO-GATE: <reason>` line anywhere in commit message body for
# legitimate bulk-mechanical changes (e.g., mass-rename, generated content).
THRESHOLD=50
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")

    for sha in $(git rev-list --no-merges --reverse "$BASE".."$LOCAL"); do
        msg=$(git log -1 --format=%B "$sha")

        # Skip if NO-GATE override is present
        if grep -qE '^NO-GATE:' < <(printf '%s\n' "$msg"); then
            continue
        fi

        # Iterate per-file with >THRESHOLD added+removed lines
        while IFS=$'\t' read -r added removed file; do
            [ -z "$file" ] && continue
            # Binary files: numstat shows "-" instead of numbers; skip
            [ "$added" = "-" ] && continue
            total=$((added + removed))
            if [ "$total" -gt "$THRESHOLD" ]; then
                base=$(basename "$file")
                if ! grep -qF "$file" < <(printf '%s\n' "$msg") && ! grep -qF "$base" < <(printf '%s\n' "$msg"); then
                    echo "[pre-push] BLOCK: commit $sha touches $file ($total lines changed) but message doesn't mention it."
                    echo "  Reason: under-documentation risk (>$THRESHOLD lines = significant scope; must appear in message)."
                    echo "  Resolve: amend message to reference $file, OR add 'NO-GATE: <reason>' line for legitimate bulk-mechanical changes."
                    echo ""
                    echo "  Commit message was:"
                    echo "$msg" | sed 's/^/    /'
                    exit 1
                fi
            fi
        done < <(git show --numstat --format='' "$sha")
    done
fi

# ---- 5. Conventional-commit format on subject line -----------------------
# Each commit subject must follow `<type>(<scope>): <description>` OR
# `<type>: <description>`. Codifies de-facto convention so the message
# format is machine-parseable. Covers common types in this repo:
#   feat, fix, docs, refactor, test, chore, perf, infra, build, ci, revert,
#   phase<N> (e.g., phase3, phase4), and case-by-case scope tags.
# Override: same NO-GATE: keyword as gate 4 also bypasses this gate.
COMMIT_TYPE_RE='^(feat|fix|docs|refactor|test|chore|perf|infra|build|ci|revert|phase[0-9]+)(\([a-zA-Z0-9_,/.\-]+\))?: .+'
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    for sha in $(git rev-list --no-merges --reverse "$BASE".."$LOCAL"); do
        msg=$(git log -1 --format=%B "$sha")
        if grep -qE '^NO-GATE:' < <(printf '%s\n' "$msg"); then
            continue
        fi
        subject=${msg%%$'\n'*}
        if ! grep -qE "$COMMIT_TYPE_RE" < <(printf '%s\n' "$subject"); then
            echo "[pre-push] BLOCK: commit $sha subject doesn't match conventional-commit format."
            echo "  Expected: <type>(<scope>): <description>  OR  <type>: <description>"
            echo "  Valid types: feat, fix, docs, refactor, test, chore, perf, infra, build, ci, revert, phase<N>"
            echo "  Got: $subject"
            echo "  Resolve: amend the commit message, OR add 'NO-GATE: <reason>' line for unconventional-but-justified subjects."
            exit 1
        fi
    done
fi

# ---- 6. Co-Authored-By trailer enforcement -------------------------------
# Owner-instituted pattern: AI-authored commits carry Co-Authored-By trailers
# for provenance. Threshold: any commit with >25 lines changed must have
# the trailer (covers all substantive agent-authored commits; trivial
# typo-fixes can skip).
COAUTH_THRESHOLD=25
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    for sha in $(git rev-list --no-merges --reverse "$BASE".."$LOCAL"); do
        msg=$(git log -1 --format=%B "$sha")
        if grep -qE '^NO-GATE:' < <(printf '%s\n' "$msg"); then
            continue
        fi
        # Compute total lines changed in this commit
        total=$(git show --numstat --format='' "$sha" | awk 'BEGIN{s=0} $1!="-" && $2!="-" {s += $1 + $2} END{print s+0}')
        if [ "$total" -gt "$COAUTH_THRESHOLD" ]; then
            if ! grep -qiE '^Co-Authored-By:' < <(printf '%s\n' "$msg"); then
                echo "[pre-push] BLOCK: commit $sha ($total lines changed) lacks Co-Authored-By trailer."
                echo "  Reason: provenance — substantive commits must declare authorship."
                echo "  Resolve: amend the commit to add (example):"
                echo "    Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>"
                echo "  OR use 'NO-GATE: <reason>' for decided commits."
                exit 1
            fi
        fi
    done
fi

# ---- 7. Commit-message public-content audit ------------------------------
# Per Group P (owner-flagged 2026-05-07): commit messages are public history.
# Gate 1 scans file content but not commit messages; agent abbreviations,
# internal vocab, and AGENT-NAME patterns can slip through into git log via
# the message body. This gate scans messages of pushed commits with the same
# patterns gate 1 uses on file content.
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    require_gate_can_run scripts/check-public-content.py "commit-message audit"
    PY7="$PY_BIN"
    if [ -n "$PY7" ]; then
        BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
        if ! "$PY7" scripts/check-public-content.py --commit-msgs "${BASE}..${LOCAL}"; then
            echo "[pre-push] BLOCK: commit-message audit failed (see above)"
            echo "  Resolve: amend the flagged commit message(s) before pushing."
            echo "    git rebase -i ${BASE}      # interactive rebase to amend specific commits"
            echo "  OR for legitimate uses, add to scripts/check-public-content.allowlist."
            exit 1
        fi
    fi
fi

# ---- 8. New package.yml MUST declare verify_paths -----------------------
# Stop-the-bleeding gate for the linux-firmware-class regression: any new
# packages/<tier>/<name>/package.yml file in the to-be-pushed commits must
# declare a `verify_paths:` field (or `pending_acquisition:` for deliberately-
# deferred packages). This forces every NEW package to self-document the
# files it produces, so the pre-squashfs audit has teeth from day one.
# Existing packages without verify_paths (the 294-package backlog) are
# tracked separately and not gated here — modifications to those won't
# fail this gate. Override: NO-GATE keyword in commit body.
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    # Check each commit in the push range; collect NO-GATE-exempted shas
    NEW_YMLS=()
    for sha in $(git rev-list --no-merges --reverse "$BASE".."$LOCAL"); do
        msg=$(git log -1 --format=%B "$sha")
        if grep -qE '^NO-GATE:' < <(printf '%s\n' "$msg"); then
            continue
        fi
        # Find the package.yml files this commit INTRODUCES at packages/*/*/:
        # added (A), or arriving as the destination of a rename (R) or a copy
        # (C), with rename and copy detection asked for. Before 2026-10-09 only
        # status A was read, so a recipe reached by rename or copy was never
        # checked (a second reader's finding, 2026-10-09).
        while IFS=$'\t' read -r status path1 path2; do
            case "$status" in
                A) file="$path1" ;;
                R*|C*) file="$path2" ;;
                *) continue ;;
            esac
            if [[ "$file" =~ ^packages/[^/]+/[^/]+/package\.yml$ ]]; then
                NEW_YMLS+=("$sha:$file")
            fi
        done < <(git show --name-status --format='' -M -C "$sha")
    done

    BAD_PKGS=()
    for entry in "${NEW_YMLS[@]:-}"; do
        [ -z "$entry" ] && continue
        sha="${entry%%:*}"
        file="${entry#*:}"
        # Read the file at the version that was committed
        content=$(git show "$sha:$file" 2>/dev/null)
        if ! grep -qE '^(verify_paths|pending_acquisition)\s*:' < <(printf '%s\n' "$content"); then
            BAD_PKGS+=("$sha:$file")
        fi
    done

    if [ "${#BAD_PKGS[@]}" -gt 0 ]; then
        echo "[pre-push] BLOCK: new package.yml file(s) without verify_paths:"
        for entry in "${BAD_PKGS[@]}"; do
            sha="${entry%%:*}"
            file="${entry#*:}"
            echo "    $file  (in commit $sha)"
        done
        echo ""
        echo "  Reason: every new package must self-document load-bearing files"
        echo "  (verify_paths:) so the pre-squashfs audit has teeth. This catches"
        echo "  the linux-firmware-class regression (package recipe present,"
        echo "  package installs silently nothing) before it reaches a built ISO."
        echo ""
        echo "  Resolve options:"
        echo "    (a) Add a verify_paths: field declaring 2-3 load-bearing files"
        echo "        the package installs (see existing package.yml examples)."
        echo "    (b) For deliberately-deferred packages: use pending_acquisition:"
        echo "        with a reason (see core/shim-signed/package.yml)."
        echo "    (c) NO-GATE: <reason> in commit body for legitimate exemptions."
        exit 1
    fi
fi

# ---- 8b. Recipe phase-function shadow gate (install-recursion class) ------
# A recipe that defines an `install()` phase function (the toolchain-tier
# contract) shadows /usr/bin/install for every bare `install ...` call in
# the file — bash resolves the FUNCTION first, self-recursing. Origin: the
# GE-01 launch 2026-07-03, toolchain/glibc's m32 pass recursed for ~5h
# (kept alive by the driver's `||` suspending set -e). This gate makes the
# class impossible to land: any pushed build.sh that BOTH defines
# `install()` AND calls bare `install <args>` is blocked. The correct call
# inside install() is the full path /usr/bin/install. `install` is the
# ONLY recipe phase-function name that collides with a real command
# (census 2026-07-03: build/configure/do_install/check/post_install shadow
# nothing).
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    SHADOW_BAD=()
    for sha in $(git rev-list --no-merges --reverse "$BASE".."$LOCAL"); do
        msg=$(git log -1 --format=%B "$sha")
        grep -qE '^NO-GATE:' < <(printf '%s\n' "$msg") && continue
        while IFS=$'\t' read -r status file; do
            case "$status" in A|M) ;; *) continue ;; esac
            [[ "$file" =~ ^packages/[^/]+/[^/]+/build\.sh$ ]] || continue
            content=$(git show "$sha:$file" 2>/dev/null) || continue
            if grep -qE '^install\(\)' < <(printf '%s\n' "$content") \
               && grep -qE '^[[:space:]]+install[[:space:]]+-' < <(printf '%s\n' "$content"); then
                SHADOW_BAD+=("$sha:$file")
            fi
        done < <(git show --name-status --format='' "$sha")
    done
    if [ "${#SHADOW_BAD[@]}" -gt 0 ]; then
        echo "[pre-push] BLOCK: install() phase function + bare 'install' call (self-recursion):"
        for entry in "${SHADOW_BAD[@]}"; do
            echo "    ${entry#*:}  (in commit ${entry%%:*})"
        done
        echo ""
        echo "  Reason: inside a function named install(), a bare 'install -...' call"
        echo "  resolves to the FUNCTION and recurses infinitely (the GE-01 glibc"
        echo "  incident, ~5h of compute). Use the full path: /usr/bin/install -..."
        exit 1
    fi
fi

# ---- 9. v1.1 deferred-followup consistency -------------------------------
# Per the O-030-followup mechanism (decided 2026-05-19): every
# commit that defers scope to v1.1 must register the deferral in
# docs/v1.1-deferred-followups.md, so the ledger of v1.0/v1.1 scope splits
# stays auditable and the work cannot be silently lost. The gate scans
# commit bodies in the push range for future-version-deferral framing; each
# flagged commit must either reference an existing F-NNN entry by ID OR
# modify docs/v1.1-deferred-followups.md in the same commit. Override:
# NO-GATE keyword in commit body (use sparingly; flag operator).
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    V11_VIOLATIONS=()
    for sha in $(git rev-list --no-merges --reverse "$BASE".."$LOCAL"); do
        msg=$(git log -1 --format=%B "$sha")
        if grep -qE '^NO-GATE:' < <(printf '%s\n' "$msg"); then
            continue
        fi
        # Patterns that flag a v1.1 / post-v1.0 deferral
        if grep -qiE 'deferred to v1\.1|post-v1\.0|in v1\.1|v1\.1 follow-?up|defer.{0,40}v1\.1' < <(printf '%s\n' "$msg"); then
            has_fnnn=0
            has_doc_mod=0
            if grep -qE 'F-[0-9]{3,}' < <(printf '%s\n' "$msg"); then
                has_fnnn=1
            fi
            if grep -qx 'docs/v1.1-deferred-followups.md' < <(git show --name-only --format='' "$sha"); then
                has_doc_mod=1
            fi
            if [ "$has_fnnn" -eq 0 ] && [ "$has_doc_mod" -eq 0 ]; then
                V11_VIOLATIONS+=("$sha")
            fi
        fi
    done
    if [ "${#V11_VIOLATIONS[@]}" -gt 0 ]; then
        echo "[pre-push] BLOCK: v1.1 deferral(s) without ledger entry:"
        for sha in "${V11_VIOLATIONS[@]}"; do
            subj=$(git log -1 --format=%s "$sha")
            echo "    $sha  $subj"
        done
        echo ""
        echo "  Reason: every commit that defers scope to v1.1 must register"
        echo "  the deferral in docs/v1.1-deferred-followups.md so the work"
        echo "  is auditable and cannot be silently lost. See the doc header"
        echo "  for the entry shape."
        echo ""
        echo "  Resolve options:"
        echo "    (a) Add an F-NNN entry to docs/v1.1-deferred-followups.md"
        echo "        in this commit set, then reference its ID in the body."
        echo "    (b) Reference an existing F-NNN entry by ID if one already"
        echo "        covers this deferral."
        echo "    (c) NO-GATE: <reason> in commit body for legitimate edge"
        echo "        cases (decided authorization advised)."
        exit 1
    fi
fi

# ---- 9b. First-party release/content_hash checker (dev + master only) ----
# scripts/bump-changed-releases.py fingerprints every first-party package and
# fails when content changed without a release bump. Landing that state on an
# integration branch means a shipped package whose recorded fingerprint does
# not match its content — the mirror and pkm never see the new build. Every
# other house gate ran at push time; this one did not, so the drift the
# Chronicle merge carried (a shared generator script sitting in nine packages'
# source_tree:, drifting eight uninvolved siblings) was caught by hand rather
# than mechanically. Decided 2026-07-24: enforce it here.
#
# BRANCH-AWARE, and the narrow scope is deliberate, not an oversight:
# enforced ONLY when the push targets dev or master. A feature branch is
# EXEMPT BY DESIGN — the established flow lets a branch carry first-party
# content drift and reconciles it in the co-bump that rides the merge. A
# blanket gate would outlaw that flow and force a bump-per-branch-commit.
#
# WORKING TREE vs PUSHED CONTENT — the semantics this gate chose, and why:
#   The checker reads a repo tree, but a push publishes a COMMIT, and the two
#   are not the same bytes. A dirty tree, a soft-reset-and-edit, or a
#   `git push origin somebranch:dev` (where HEAD is not the pushed sha at all)
#   each make an in-place run report on content the push is not publishing —
#   green here, drifted on origin. Two further traps: the recorded baselines
#   are established on a pristine tree (the bump discipline is `git clean -fdX`
#   first), so build artifacts and ignored files left lying in a working tree
#   can move a fingerprint; and gate 1 above reads `--from-ref HEAD`, which is
#   the same not-necessarily-the-pushed-sha assumption (flagged separately —
#   this gate does not inherit it).
#   RESOLUTION: evaluate a throwaway detached worktree checked out AT THE SHA
#   BEING PUSHED. That is pushed-content-exact and pristine by construction,
#   independent of HEAD and of whatever the working tree currently holds. The
#   checker anchors its own REPO_ROOT to its file location, so invoking the
#   copy inside that worktree scopes it there with no argument plumbing.
#   Cost measured on the dev tip: ~3.2s wall and a transient ~380MB checkout,
#   removed immediately. That price buys an exact answer instead of a
#   plausible one, and it is paid only on a dev/master push.
#   The evaluation itself is FAIL-CLOSED: if the worktree cannot be created,
#   the gate blocks rather than waving the push through unevaluated.
RELCHECK_TARGET=""
RELCHECK_REF=""
RELCHECK_REMOTE=""
for refline in "${PUSH_REFS[@]}"; do
    read -r _lref local_sha remote_ref remote_sha <<< "$refline"
    if [ "$remote_ref" = "refs/heads/dev" ] || [ "$remote_ref" = "refs/heads/master" ]; then
        [ "$local_sha" = "$ZERO" ] && continue   # branch deletion publishes nothing
        RELCHECK_TARGET="$local_sha"
        RELCHECK_REF="${remote_ref#refs/heads/}"
        RELCHECK_REMOTE="$remote_sha"
        break
    fi
done

if [ -z "$RELCHECK_TARGET" ]; then
    echo "[pre-push] release checker: not a dev/master push — exempt by design"
elif [ -z "$PY_BIN" ]; then
    echo "[pre-push] BLOCK: no Python 3 interpreter found; pushed-content gates cannot run"
    echo "  A dev/master push that was not inspected is not a passing push."
    exit 1
else
    echo "[pre-push] release checker: evaluating $(git rev-parse --short=8 "$RELCHECK_TARGET") as pushed to $RELCHECK_REF..."
    RELCHECK_TMP=$(mktemp -d 2>/dev/null || echo "")
    if [ -z "$RELCHECK_TMP" ] || [ ! -d "$RELCHECK_TMP" ]; then
        echo "[pre-push] BLOCK: could not create a temporary directory to evaluate the pushed content."
        echo "  The release checker is fail-closed: an unevaluated push to $RELCHECK_REF is not permitted."
        echo "  Bypass for genuine emergency: git push --no-verify (flag in commit msg)"
        exit 1
    fi
    RELCHECK_WT="$RELCHECK_TMP/wt"
    cleanup_relcheck_worktree() {
        if [ -n "${RELCHECK_WT:-}" ] && [ -d "$RELCHECK_WT" ]; then
            git worktree remove --force "$RELCHECK_WT" >/dev/null 2>&1 || true
        fi
        if [ -n "${RELCHECK_TMP:-}" ] && [ -d "$RELCHECK_TMP" ]; then
            rm -rf "$RELCHECK_TMP"
        fi
    }
    trap cleanup_relcheck_worktree EXIT HUP INT TERM
    if ! git worktree add --detach "$RELCHECK_WT" "$RELCHECK_TARGET" >/dev/null 2>&1; then
        cleanup_relcheck_worktree
        trap - EXIT HUP INT TERM
        echo "[pre-push] BLOCK: could not check out $(git rev-parse --short=8 "$RELCHECK_TARGET") to evaluate release/content_hash state."
        echo "  The release checker is fail-closed: an unevaluated push to $RELCHECK_REF is not permitted."
        echo "  Inspect: git worktree add --detach <dir> $RELCHECK_TARGET"
        echo "  Bypass for genuine emergency: git push --no-verify (flag in commit msg)"
        exit 1
    fi
    RELCHECK_OUT=""
    RELCHECK_RC=0
    if [ -f "$RELCHECK_WT/scripts/bump-changed-releases.py" ] \
            && [ ! -L "$RELCHECK_WT/scripts/bump-changed-releases.py" ]; then
        RELCHECK_OUT=$("$PY_BIN" "$RELCHECK_WT/scripts/bump-changed-releases.py" --check 2>&1) || RELCHECK_RC=$?
    else
        RELCHECK_OUT="release checker: candidate has no regular scripts/bump-changed-releases.py — legacy checker skipped"
    fi

    # ---- 9c. Pinned-upstream recipes the bump machine does NOT track ------
    # Run while the pristine worktree above still exists, so this costs no second
    # ~380MB checkout. Same dev/master scope as 9b, deliberately: a feature branch
    # still reconciles at the merge, and the dev push is where the class actually
    # had to be stopped (it reached the publish preflight instead).
    #
    # The class, measured at cf6fe6b05: a recipe that pins a sha256 upstream source,
    # declares no source_tree:, and ships no first-party sibling file beyond
    # build.sh/package.yml is never enumerated by bump-changed-releases.py, so its
    # build.sh can change at an unchanged (version,release) with nothing to refuse it.
    # rocminfo is that shape and its own r2 note says so. The gate VERIFIES the hand
    # bump; the machine still owns every number it tracks.
    PINCHECK_RC=0
    PINCHECK_OUT=""
    if [ -f "$RELCHECK_WT/scripts/check-pinned-recipe-bumps.py" ]; then
        if [ -n "$RELCHECK_REMOTE" ] && [ "$RELCHECK_REMOTE" != "$ZERO" ]; then
            PINCHECK_BASE=$(git merge-base "$RELCHECK_TARGET" "$RELCHECK_REMOTE" 2>/dev/null || echo "$RELCHECK_REMOTE")
        else
            PINCHECK_BASE=$(git merge-base "$RELCHECK_TARGET" origin/master 2>/dev/null || echo "")
        fi
        if [ -n "$PINCHECK_BASE" ]; then
            PINCHECK_OUT=$("$PY_BIN" "$RELCHECK_WT/scripts/check-pinned-recipe-bumps.py" \
                --repo "$REPO_ROOT" --base "$PINCHECK_BASE" --head "$RELCHECK_TARGET" \
                --worktree "$RELCHECK_WT" 2>&1) || PINCHECK_RC=$?
        else
            PINCHECK_OUT="pinned-recipe bump gate: no derivable base — refusing to report a pass"
            PINCHECK_RC=1
        fi
    fi

    # ---- 9d. THIRD-PARTY-NOTICES.md regeneration gate (decided 2026-08-16) --
    # Run while the pristine worktree above still exists, same dev/master scope
    # as 9b/9c. The class, measured: two independent correct recipe fixes
    # (license-identifier corrections + a version pin) left the committed
    # attribution file printing superseded values for eleven days, because the
    # file is generated and nothing re-derived it. The generator's --check mode
    # regenerates in memory from the PUSHED tree and refuses on any byte drift.
    NOTICES_RC=0
    NOTICES_OUT=""
    if [ -f "$RELCHECK_WT/scripts/generate-third-party-notices.py" ]; then
        NOTICES_OUT=$(cd "$RELCHECK_WT" && "$PY_BIN" scripts/generate-third-party-notices.py --check 2>&1) || NOTICES_RC=$?
    fi

    # ---- 9e. Package-manager execution inventory (dev + master) ----------
    # This gate shares 9b's detached worktree so it reads the exact commit
    # being pushed, never the caller's checkout.  Every instrument and input
    # must be a tracked regular blob in that commit; a missing file, symlink,
    # malformed contract, incomplete census, or drift is a refusal.
    PKM_INV_RC=0
    PKM_INV_OUT=""
    PKM_INV_REQUIRED=(
        scripts/check-pkm-execution-inventory.py
        scripts/lib/pkm_execution_inventory.py
        config/pkm-execution-inventory.tsv
        config/pkm-execution-shapes.tsv
        config/pkm-process-calls.tsv
        config/pkm-safe-python-launchers.tsv
    )
    PKM_INV_MISSING=()
    for _pkm_inv_rel in "${PKM_INV_REQUIRED[@]}"; do
        _pkm_inv_entry=$(git ls-tree "$RELCHECK_TARGET" -- "$_pkm_inv_rel" 2>/dev/null || true)
        read -r _pkm_inv_mode _pkm_inv_type _pkm_inv_object _pkm_inv_path <<< "$_pkm_inv_entry"
        if { [ "$_pkm_inv_mode" != "100644" ] && [ "$_pkm_inv_mode" != "100755" ]; } \
                || [ "$_pkm_inv_type" != "blob" ] \
                || [ ! -f "$RELCHECK_WT/$_pkm_inv_rel" ] \
                || [ -L "$RELCHECK_WT/$_pkm_inv_rel" ] \
                || [ ! -r "$RELCHECK_WT/$_pkm_inv_rel" ]; then
            PKM_INV_MISSING+=("$_pkm_inv_rel")
        fi
    done
    if [ "${#PKM_INV_MISSING[@]}" -ne 0 ]; then
        PKM_INV_RC=2
        PKM_INV_OUT="pkm execution inventory: ERROR: missing or not a regular in-tree blob"
        for _pkm_inv_rel in "${PKM_INV_MISSING[@]}"; do
            PKM_INV_OUT+=$'\n'"  $_pkm_inv_rel"
        done
    else
        PKM_INV_OUT=$(cd "$RELCHECK_WT" && "$PY_BIN" -P \
            "$RELCHECK_WT/scripts/check-pkm-execution-inventory.py" \
            --root "$RELCHECK_WT" \
            --inventory "$RELCHECK_WT/config/pkm-execution-inventory.tsv" \
            --process-calls "$RELCHECK_WT/config/pkm-process-calls.tsv" \
            --shapes "$RELCHECK_WT/config/pkm-execution-shapes.tsv" \
            --safe-launchers "$RELCHECK_WT/config/pkm-safe-python-launchers.tsv" \
            2>&1) || PKM_INV_RC=$?
    fi

    cleanup_relcheck_worktree
    trap - EXIT HUP INT TERM
    printf '%s\n' "$PKM_INV_OUT" | sed 's/^/  /'
    if [ "$RELCHECK_RC" -ne 0 ]; then
        echo "[pre-push] BLOCK: first-party content changed without a release bump."
        echo ""
        printf '%s\n' "$RELCHECK_OUT" | sed 's/^/    /'
        echo ""
        echo "  Every package listed above has content that no longer matches its"
        echo "  recorded content_hash, so pkm and the mirror would never see the new"
        echo "  build. Note a shared input (a generator script named in several"
        echo "  packages' source_tree:) drifts every package that declares it, which"
        echo "  is why packages you did not touch can appear in that list."
        echo ""
        echo "  Resolve — the values are machine-owned, never hand-edited:"
        echo "    git clean -fdX                                # baselines are recorded on a pristine tree"
        echo "    $PY_BIN scripts/bump-changed-releases.py      # bumps release: + records content_hash:"
        echo "    git commit -am 'chore(releases): ...'         # commit the machine-written values"
        echo "  Then re-push. Verify with: $PY_BIN scripts/bump-changed-releases.py --check"
        echo ""
        if [ "$PINCHECK_RC" -ne 0 ]; then
            # MEASURED 2026-08-16, and the reason this is reported HERE rather than only
            # on 9b's success path: editing an UNTRACKED pinned recipe's build.sh moves
            # a COUPLED tracked package's fingerprint (the installer-hooks fold reaches
            # every recipe). So 9b fires and names the coupled package — for a rocminfo
            # build.sh edit it printed `forge: content changed but release not bumped`
            # and nothing about rocminfo. Its resolve steps then bump forge and leave the
            # recipe the author actually changed still unbumped. Reporting 9c's finding
            # alongside 9b's is what turns a misleading refusal into a correct one.
            echo ""
            echo "  ALSO — and this is very likely the change you actually made:"
            printf '%s\n' "$PINCHECK_OUT" | sed 's/^/  /'
        fi
        echo "  Bypass for genuine emergency: git push --no-verify (flag in commit msg)"
        exit 1
    fi
    printf '%s\n' "$RELCHECK_OUT" | sed 's/^/  /'
    if [ "$PINCHECK_RC" -ne 0 ]; then
        printf '%s\n' "$PINCHECK_OUT" | sed 's/^/  /'
        echo "[pre-push] BLOCK: an untracked pinned-upstream recipe changed without a bump."
        echo "  Bypass for genuine emergency: git push --no-verify (flag in commit msg)"
        exit 1
    fi
    printf '%s\n' "$PINCHECK_OUT" | sed 's/^/  /'
    if [ "$NOTICES_RC" -ne 0 ]; then
        printf '%s\n' "$NOTICES_OUT" | sed 's/^/  /'
        echo "[pre-push] BLOCK: THIRD-PARTY-NOTICES.md is stale against the pushed tree (gate 9d)."
        echo "  Bypass for genuine emergency: git push --no-verify (flag in commit msg)"
        exit 1
    fi
    printf '%s\n' "$NOTICES_OUT" | sed 's/^/  /'
    if [ "$PKM_INV_RC" -eq 1 ]; then
        echo "[pre-push] BLOCK: package-manager execution inventory drifted (gate 9e)."
        exit 1
    elif [ "$PKM_INV_RC" -eq 2 ]; then
        echo "[pre-push] BLOCK: package-manager execution inventory could not produce a complete verdict (gate 9e)."
        exit 1
    elif [ "$PKM_INV_RC" -ne 0 ]; then
        echo "[pre-push] BLOCK: package-manager execution inventory exited unexpectedly with $PKM_INV_RC (gate 9e)."
        exit 1
    fi
fi

# ---- 9.5 Release-validation gate (master pushes only; fail-closed) --------
# A push to master IS the promotion. R001.1 reached users with its composition
# properties broken and every unit test green, because nothing required the
# installed-system gate tier (tests/installed/) to have been RUN against the
# candidate on real hardware. This gate is that requirement at the moment of
# promotion.
#
# MASTER ONLY, and the narrow scope is deliberate: dev is an integration branch
# and a feature branch is not a release. Only master publishes to users.
#
# THE PUSHED COMMIT IS THE SUBJECT, AND ALSO THE INSTRUMENT. The candidate
# identity is read from the SHA BEING PUSHED, and the checking script is run
# from a throwaway detached worktree at that same sha — the resolution gate 9b
# already uses, for the same reason: a push publishes a commit, and the working
# tree is not necessarily those bytes.
#   MEASURED 2026-08-24, which is why it is written this way: a first version
#   tested `-f scripts/check-release-validation.py` against the working tree.
#   Rehearsing a promotion from a tree that predated the script then refused
#   with "the gate could not run" in every state, including the states meant to
#   pass. Nothing unsafe happened — the refusal is fail-closed — but the reason
#   named the wrong cause, and a gate whose subject and instrument come from
#   different bytes cannot say which bytes it judged.
#
# There is no override. A missing record is NOT VALIDATED, never validated by
# absence. Producing one is scripts/run-installed-gates.py on a real install,
# launched through sudo from a tree only root can write: a launch without root
# leaves the root tier unmeasured, and the release gate refuses that record.
RELVAL_MASTER=""
for refline in "${PUSH_REFS[@]}"; do
    read -r _lref local_sha remote_ref remote_sha <<< "$refline"
    if [ "$remote_ref" = "refs/heads/master" ] && [ "$local_sha" != "$ZERO" ]; then
        RELVAL_MASTER="$local_sha"
        break
    fi
done

if [ -n "$RELVAL_MASTER" ]; then
    echo "[pre-push] release-validation gate: promotion to master detected..."
    if [ -z "$PY_BIN" ]; then
        echo "[pre-push] BLOCK: no Python 3 interpreter is available, so the"
        echo "  release-validation gate cannot run. A promotion that skipped the"
        echo "  check is indistinguishable from one that passed it."
        exit 1
    fi
    if [ -z "${RELEASE_VALIDATION_RECORD:-}" ]; then
        echo "[pre-push] BLOCK: RELEASE_VALIDATION_RECORD is not set."
        echo "  Promoting to master publishes this release to users, and the"
        echo "  installed-system gates have not been recorded against it."
        echo "  Produce a record on a real installed machine: export the commit"
        echo "  into a directory only root can write, then launch the runner"
        echo "  through sudo, from a directory outside any checkout, as the account"
        echo "  the gates measure, with the machine's shape (fresh from the release"
        echo "  medium, upgrade when the package manager moved it from an earlier"
        echo "  release). A launch without root leaves the root tier unmeasured,"
        echo "  and that record is refused."
        echo "    git -c tar.umask=0022 archive -o <tree>.tar <commit>"
        echo "    sudo mkdir -p -m 0755 /var/lib/intergenos-validation"
        echo "    sudo mkdir -m 0755 /var/lib/intergenos-validation/<commit>"
        echo "    sudo tar -x -f <tree>.tar -C /var/lib/intergenos-validation/<commit>"
        echo "    sudo python3 /var/lib/intergenos-validation/<commit>/scripts/run-installed-gates.py \\"
        echo "        --tier /var/lib/intergenos-validation/<commit>/tests/installed --output <dir> \\"
        echo "        --shape <fresh|upgrade>"
        echo "  (docs/operations/11-resolving-validation-gates.md). Sign the record,"
        echo "  then set RELEASE_VALIDATION_RECORD=<dir> and push again."
        echo "  A missing record is NOT VALIDATED."
        exit 1
    fi
    RELVAL_RECIPE_TEXT=$(git show "$RELVAL_MASTER:packages/ai/intergen/package.yml" 2>/dev/null || echo "")
    if [ -z "$RELVAL_RECIPE_TEXT" ]; then
        echo "[pre-push] BLOCK: could not read the candidate identity from the"
        echo "  commit being pushed. Without it a record cannot be matched to"
        echo "  anything, so it cannot validate anything."
        exit 1
    fi
    RELVAL_RELEASE=$(printf '%s\n' "$RELVAL_RECIPE_TEXT" | sed -n 's/^release:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | sed -n 1p)
    RELVAL_HASH=$(printf '%s\n' "$RELVAL_RECIPE_TEXT" | sed -n 's/^content_hash:[[:space:]]*\([0-9a-f][0-9a-f]*\).*/\1/p' | sed -n 1p)
    if [ -z "$RELVAL_RELEASE" ] || [ -z "$RELVAL_HASH" ]; then
        echo "[pre-push] BLOCK: the pushed commit's package.yml carries no"
        echo "  parseable release/content_hash pair."
        exit 1
    fi
    RELVAL_TMP=$(mktemp -d 2>/dev/null || echo "")
    if [ -z "$RELVAL_TMP" ] || [ ! -d "$RELVAL_TMP" ]; then
        echo "[pre-push] BLOCK: could not create a temporary directory to evaluate"
        echo "  the pushed content. The gate is fail-closed: an unevaluated"
        echo "  promotion to master is not permitted."
        exit 1
    fi
    RELVAL_WT="$RELVAL_TMP/wt"
    if ! git worktree add --detach "$RELVAL_WT" "$RELVAL_MASTER" >/dev/null 2>&1; then
        rm -rf "$RELVAL_TMP"
        echo "[pre-push] BLOCK: could not check out the commit being pushed to"
        echo "  evaluate it. The gate is fail-closed: an unevaluated promotion to"
        echo "  master is not permitted."
        exit 1
    fi
    RELVAL_SCRIPT="$RELVAL_WT/scripts/check-release-validation.py"
    if [ ! -f "$RELVAL_SCRIPT" ]; then
        git worktree remove --force "$RELVAL_WT" >/dev/null 2>&1 || true
        rm -rf "$RELVAL_TMP"
        echo "[pre-push] BLOCK: the commit being pushed to master carries no"
        echo "  scripts/check-release-validation.py, so this promotion cannot be"
        echo "  checked at all. The absence of the gate is not a passing gate."
        exit 1
    fi
    RELVAL_RC=0
    "$PY_BIN" "$RELVAL_SCRIPT" \
        --record "$RELEASE_VALIDATION_RECORD" \
        --candidate-release "$RELVAL_RELEASE" \
        --candidate-content-hash "$RELVAL_HASH" || RELVAL_RC=$?
    git worktree remove --force "$RELVAL_WT" >/dev/null 2>&1 || true
    rm -rf "$RELVAL_TMP"
    # The checker reserves 1 for "not validated" and 2 for "you invoked me
    # wrong" so a caller can tell them apart. Both refuse the push — an
    # undecided release is not a validated one — but they are never reported as
    # the same thing.
    if [ "$RELVAL_RC" -eq 2 ]; then
        echo "[pre-push] BLOCK: the release-validation gate was invoked incorrectly"
        echo "  (exit 2 = usage error). Nothing was decided about this release."
        exit 1
    elif [ "$RELVAL_RC" -ne 0 ]; then
        echo "[pre-push] BLOCK: release-validation gate refused (see above)."
        echo "  Refusing to promote an unvalidated release to master."
        exit 1
    fi
    echo "[pre-push] release-validation gate passed"
fi

# ---- 9.6 Release-note chain gate ------------------------------------------
# The machine owns the release NUMBER (bump-changed-releases.py); the note
# chain in the same line's comment is authored by hand, and nothing made
# the two move together — machine bumps shipped stale chain heads (intergen
# release 130 / head r109, forge the same 20-wide, 2026-07-30). Delta-only:
# fires solely on commits that CHANGE a release value or inline comment,
# so the legacy backlog never blocks a push. Per-commit NO-GATE override
# honored inside the script.
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    require_gate_can_run scripts/check-release-notes.py "release-note chain gate"
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    if ! "$PY_BIN" scripts/check-release-notes.py --base "$BASE" --head "$LOCAL"; then
        echo "[pre-push] BLOCK: changed release-note chain is invalid (see above)."
        echo "  Keep older notes byte-exact on the release line; a bump adds its rNN head."
        echo "  Amend the same commit, or use NO-GATE with a reason."
        exit 1
    fi
fi

# ---- 9.7 Changelog accumulation gate --------------------------------------
# CHANGELOG.md was absent for R001 entirely and its frame still read
# v1.0-Unreleased afterwards, because nothing connected the act of changing
# what ships to the act of recording it. This gate makes that connection at
# the cheapest point, the push.
#
# Delta-only and deliberately NARROW: it fires on a commit that changes a
# package's upstream `version:`, ADDS a packages/*/*/package.yml, or DELETES
# one. A release-only bump does NOT fire it — that is a rebuild or metadata
# change, and gate 9.6 above already enforces the recipe's own `# rNN:` note
# chain for exactly those. Measured over the last 40 commits on the
# development branch: keying on any release bump would have blocked 21 of
# them, so the exemption trailer would become boilerplate on more than half
# of all pushes; the narrowed trigger blocks none of the 40 while still
# blocking the R001.1 package wave with all 20 of its additions named.
#
# Satisfied by CHANGELOG.md being touched anywhere in the push RANGE (a bump
# in one commit and its entry in the next is ordinary work), or by a
# reasoned `Changelog-Exempt: <reason>` trailer on the triggering commit.
# Per-commit NO-GATE override honored inside the script.
#
# Absence of the script or of a Python interpreter refuses the push, and since
# 2026-09-17 gate 9.6 above does the same — it skipped both conditions without
# a word until then. A gate that can vanish quietly reports the same nothing
# whether it passed or was never there, and the whole point of this one is that
# a record cannot go missing unnoticed.
if [ -n "$LOCAL" ] && [ -n "$REMOTE" ] && [ "$LOCAL" != "$REMOTE" ]; then
    require_gate_can_run scripts/check-changelog-accumulation.py "changelog accumulation gate"
    BASE=$(git merge-base "$LOCAL" "$REMOTE" 2>/dev/null || echo "$REMOTE")
    if ! "$PY_BIN" scripts/check-changelog-accumulation.py --base "$BASE" --head "$LOCAL"; then
        echo "[pre-push] BLOCK: this push changes the shipped package set without a changelog record (see above)."
        echo "  Add the entry to CHANGELOG.md in this push, or put"
        echo "  \`Changelog-Exempt: <why this does not belong in a user-facing"
        echo "  changelog>\` in the triggering commit's message."
        exit 1
    fi
fi

# ---- 10. TRACKER anchor advancement (anti-drift; cross-repo lock-step) ---
# Every push to public-repo master advances the private-repo TRACKER's
# anchor line in lock-step. Drift becomes mechanically impossible at the
# push boundary: you cannot ship a public-master commit without the
# private-repo TRACKER recording it.
#
# Auto-anchor mode: this gate calls scripts/anchor-tracker.sh to do the
# bookkeeping (rewrite anchor line + commit + push private repo). If the
# private-repo push fails, this gate fails too — preventing public master
# from advancing ahead of private TRACKER.
#
# Substantive TRACKER content updates (STATE banner refresh, new entries)
# are handled manually and land as separate manual commits to the
# private repo; this gate only ensures the anchor-bookkeeping piece is
# always in sync.
#
# Only fires when pushing to master (other branches don't anchor), AND only
# when the push is going to the real publication target.
#
# THE SECOND CONDITION IS NOT A REFINEMENT — it is the fix for a measured
# incident (2026-08-24). This gate performs an OUTWARD, hard-to-reverse write:
# it commits and pushes an anchor line into the private repository, asserting
# that public master advanced. It used to decide that from the ref name alone.
# A proof harness made a throwaway clone, gave it a local bare remote, and
# pushed master at it to exercise a different gate; this gate could not tell the
# difference and recorded a promotion that never happened. A correcting commit
# was needed to undo it.
#
# The decision is made on the remote URL ($2 above), never the remote NAME: a
# throwaway clone is free to call its local bare remote "origin". The URL
# matching lives in scripts/anchor-remote-is-public-origin.sh, which compares
# the normalised (host, owner, repository) triple for whole-value equality —
# never a prefix (the private repository's path begins with the public one's)
# and never a substring (a host can be suffixed to look like the real one).
#
# It fails CLOSED in the safe direction: an unrecognised or missing URL does NOT
# anchor. Declining to anchor costs a manual anchor advance; anchoring wrongly
# writes a false record into another repository.
ANCHOR_NEEDED=0
for refline in "${PUSH_REFS[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha <<< "$refline"
    if [ "$remote_ref" = "refs/heads/master" ]; then
        ANCHOR_NEEDED=1
        ANCHOR_TARGET="$local_sha"
        break
    fi
done

if [ "$ANCHOR_NEEDED" = "1" ]; then
    _anchor_matcher="$REPO_ROOT/scripts/anchor-remote-is-public-origin.sh"
    if [ ! -x "$_anchor_matcher" ]; then
        # The gate cannot establish that this push is a real promotion, so it
        # must not write outward. Loud, because a silently-skipped anchor is
        # indistinguishable from an advanced one when read back from a capture.
        echo "[pre-push] anchor: $_anchor_matcher missing or not executable — no anchor"
        echo "  The anchor gate cannot confirm this push targets the public origin,"
        echo "  so it declines to write to the private repository. Restore the"
        echo "  script, or advance the anchor by hand."
        ANCHOR_NEEDED=0
    elif ! "$_anchor_matcher" "$PUSH_REMOTE_URL" >/dev/null 2>&1; then
        echo "[pre-push] anchor: not the public origin — no anchor"
        echo "  remote name: ${PUSH_REMOTE_NAME:-<none given>}"
        echo "  remote URL:  ${PUSH_REMOTE_URL:-<none given>}"
        echo "  Only a push to the project's public repository is a promotion."
        echo "  The private repository is not touched for any other target."
        ANCHOR_NEEDED=0
    fi
fi

if [ "$ANCHOR_NEEDED" = "1" ]; then
    if [ -x "$REPO_ROOT/scripts/anchor-tracker.sh" ]; then
        echo "[pre-push] advancing TRACKER anchor to $(git rev-parse --short=8 "$ANCHOR_TARGET")..."
        if ! "$REPO_ROOT/scripts/anchor-tracker.sh" "$ANCHOR_TARGET"; then
            echo "[pre-push] BLOCK: TRACKER anchor advancement failed."
            echo "  Refusing to push public master while private TRACKER is out of sync."
            echo "  Inspect: cd \"\$INTERGENOS_PRIVATE_REPO\" && git status + git log -1"
            echo "  (private repo path is configurable via INTERGENOS_PRIVATE_REPO env var;"
            echo "   defaults to a sibling of the public repo: ../intergenos-private)"
            echo "  Bypass for genuine emergency: git push --no-verify (flag in commit msg)"
            exit 1
        fi
    else
        echo "[pre-push] BLOCK: the TRACKER anchor step could not run — scripts/anchor-tracker.sh is missing or not executable."
        echo "  Reason: this push updates public master, and the private ledger anchor is part of that promotion."
        echo "  Resolve: restore scripts/anchor-tracker.sh and make it executable."
        exit 1
    fi
fi

if [ "$PUSH_LOCAL" = "$PUSH_REMOTE" ]; then echo "[pre-push] local ref equals remote ref; the push range is empty; gates 3 (syntax), 4 (commit-message scope), 5 (conventional subject), 6 (trailer), 7 (commit-message audit), 8 (new package verify_paths), 8b (recipe phase shadowing), 9 (v1.1 follow-up consistency), 9.6 (note chain), and 9.7 (changelog) were not run."; else echo "[pre-push] all gates PASS"; fi
exit 0
