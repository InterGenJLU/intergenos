#!/bin/sh
# /usr/bin/intergen-privileged-runner — pkexec target for InterGen privileged tools.
#
# Invoked via pkexec when a tool the provenance gate classified
# PRIVILEGED_STATE_CHANGING (per RFC v0.1 §6) has been authorized for
# execution. Runs as root after PolicyKit authentication against
# org.intergenos.intergen.privileged-tool.
#
# HOW IT IS STARTED (changed 2026-08-24). The assistant no longer runs pkexec
# as its own child. Its systemd user unit sets NoNewPrivileges=yes, which every
# child inherits and which cannot be cleared once set; under that flag the
# kernel ignores pkexec's setuid bit, so pkexec starts unprivileged, sees its
# own effective uid is not root, and refuses before PolicyKit is contacted at
# all. The assistant now asks its own systemd user manager to start a
# short-lived unit that runs the same pkexec invocation; that manager does not
# carry the flag, so this runner is reached. Nothing in the assistant's own
# hardening changed, and the PolicyKit action gating this path is unchanged.
#
# Two-layer security:
#   1. PolicyKit (this runner is the exec.path target) — handles
#      AUTHENTICATION (user enters password; cached per session via
#      auth_admin_keep).
#   2. intergen.privileged_dispatch (Python entry point) — handles
#      AUTHORIZATION (validates tool name against allowlist + validates
#      arguments per-tool + verifies the human-approval token + executes the
#      underlying command). That validation lives in Python because the
#      privileged-tool allowlist and the per-tool argument schemas live with the
#      intergen tool registry (intergen/tool_registry.py), and the runner must
#      call back into that registry to enforce the same contract intergen
#      enforced before the privilege crossing.
#
# ARGV CONTRACT (from the intergen caller, through pkexec):
#   $1 — path to the request file.
#
# That is the whole command line, and it is the point. The request file holds
# the tool name, the arguments, and the human-approval token; it is owner-only
# and it is removed as it is read. Those three values used to be argv words
# instead, and a command line is world-readable through /proc/<pid>/cmdline for
# the life of the process — on this image /proc carries no hidepid, so any local
# account could read the approval token and the tool arguments out of the
# process listing while a dispatch was in flight. pkexec deliberately scrubs the
# environment as it crosses the privilege boundary, which is why argv was used
# in the first place; carrying a PATH rather than the values themselves keeps
# that property and publishes nothing. The path is not a secret; the contents
# are, and they are protected by file permissions.
#
# The runner stays a thin shim: $1 passes through to Python untouched, and
# Python does every check — including verifying that the file it is about to
# read is a regular file, owned by the calling user, mode 0600, unlinked and
# not a symlink. The runner's other job is to set up a clean root-context
# environment and propagate the calling user's identity for downstream tools
# that care about it (e.g. write_file's path-ownership semantics).

set -eu

# Refuse to run outside a pkexec context. A direct root invocation would
# bypass PolicyKit authentication entirely + would not have PKEXEC_UID
# set, breaking the calling-user identity propagation that the Python
# dispatcher relies on. This mirrors forge-gui-runner's defensive check
# at /usr/bin/forge-gui-runner:27-30.
PKEXEC_UID="${PKEXEC_UID:-}"
if [ -z "${PKEXEC_UID}" ]; then
    printf 'intergen-privileged-runner: PKEXEC_UID unset; refusing to run outside pkexec.\n' >&2
    exit 1
fi

# Argv strict equality: the request path, no extras. Narrowed from three
# arguments to one when the tool name, arguments and token moved into the
# request file. STRICT equality is kept so a caller still cannot smuggle extra
# positional arguments past this entry point — any further argv would either be
# silently ignored or could be exploited via downstream argv-shaping.
if [ "$#" -ne 1 ]; then
    printf 'intergen-privileged-runner: usage: intergen-privileged-runner <request_id> (exactly 1 arg)\n' >&2
    exit 2
fi

# The single argument is an IDENTIFIER, not a path (changed 2026-08-24). It is
# checked here, at the first thing that runs as root, against a pattern that
# admits nothing but lower-case hex of the generated length. A traversal, an
# absolute path, a shell metacharacter, a newline: none of them match, so none
# of them reach the dispatcher. The dispatcher re-derives the path from
# PKEXEC_UID and verifies the directory as well; this is the outer of two
# checks, not the only one.
REQUEST_ID="$1"
shift
case "${REQUEST_ID}" in
    *[!0-9a-f]* | "")
        printf 'intergen-privileged-runner: request identifier is not hex; refusing.\n' >&2
        exit 2
        ;;
esac
if [ "${#REQUEST_ID}" -ne 32 ]; then
    printf 'intergen-privileged-runner: request identifier is not 32 characters; refusing.\n' >&2
    exit 2
fi

# Resolve the calling user's name (downstream tools may need
# /home/$USER context — e.g. write_file refuses to overwrite a
# file under another user's $HOME, which requires knowing the
# user). getent over $USER from /etc/passwd via uid since the
# pkexec environment may have stripped USER.
PKEXEC_USER=$(getent passwd "${PKEXEC_UID}" 2>/dev/null | cut -d: -f1)
if [ -z "${PKEXEC_USER}" ]; then
    printf 'intergen-privileged-runner: cannot resolve user for uid %s\n' "${PKEXEC_UID}" >&2
    exit 1
fi

# Sanitize environment. The LLM cannot inject env vars (provenance gate
# blocks ingress-influenced calls from reaching pkexec), but the
# intergen process itself runs as the user + carries user-session env.
# Clean PATH + locale + identity vars to a minimal known-safe set so
# privileged tool dispatch is deterministic regardless of how the
# user's shell was configured upstream. The Python dispatcher reads
# PKEXEC_UID + PKEXEC_USER directly; no other env propagation needed
# for the v1.0 minimum (manage_services + manage_packages + run_command
# + write_file all operate on system state without user-env input).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export HOME=/root
export PKEXEC_UID
export PKEXEC_USER

# Hand off to the Python dispatcher. Its argv is the request identifier and
# nothing else; the tool name, the arguments and the approval token are read from the
# file, which the dispatcher removes as it reads. python3 is guaranteed-present
# per packages/core/python (the intergen Python module ships with the same
# package set; if python3 disappears, intergen itself is broken upstream of this
# point and the issue surfaces before any tool dispatch).
exec /usr/bin/python3 -m intergen.privileged_dispatch --request-id "${REQUEST_ID}"
