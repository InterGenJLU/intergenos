      "class": "firewall",
      "question_examples": [
        "is the firewall on?",
        "is the firewall running?",
        "firewall status"
      ],
      "command": "systemctl is-active nftables.service",
      "also_runs": [
        "systemctl is-enabled nftables.service"
      ],
      "probe": "the nftables service's state; its rules are read with nft, which needs root and netlink (BLOCKED in the daemon), so they are named as unread (router._posture_render_firewall)",
      "tool": "run_command",
      "requires": [
        "systemctl"
      ],
      "read_only": true,
      "ships_via": "systemd (nftables.service from nftables)",
      "corpus_entries": [
        "net-firewall"
      ]
    },
