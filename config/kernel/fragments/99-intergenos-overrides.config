# InterGenOS Kernel Config Overrides
# Options not covered by the universal baseline (5-distro convergence)
# These are InterGenOS-specific choices or niche hardware drivers

# --- OS identity ---
# This "-igos" is the BASE localversion. At kernel build time both build.sh
# scripts (linux-kernel + linux-kernel-pass2) REWRITE this line to
# "-igos-<release>" (e.g. "-igos-2"), reading <release> from
# packages/core/linux-kernel/package.yml — so uname -r returns
# "6.18.10-igos-<release>", matching the build.sh-installed filename
# `vmlinuz-6.18.10-igos-<release>`, the modules dir `/lib/modules/<that>/`, the
# UKI name, and what pkm + the mirror report. chroot-build-bootloader.sh derives
# the same FULL_KVER from the release. (Keeping the base value here means a
# fragment-only build still gets a coherent "-igos" kernel.)
# OS-identity discipline: distro markers (kernel localversion, GCC target
# triplet `x86_64-igos-linux-gnu`, kernel filename) stay consistent across
# all surfaces.
CONFIG_LOCALVERSION="-igos"

# --- Architecture ---
CONFIG_X86_64=y
CONFIG_NR_CPUS=512
CONFIG_PREEMPT=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_X86_ACPI_CPUFREQ=y

# --- Storage ---
# RULE: Everything between CPU and root filesystem MUST be built-in.
# No initramfs should ever be required to mount root on any hardware.
# This includes: storage controllers, their dependencies, SCSI disk,
# filesystems, and partition tables. If a driver is =y, every module
# in its dependency chain must ALSO be =y.
#
# SATA (most desktops, older laptops)
CONFIG_ATA=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
# NVMe (modern laptops, SSDs) + dependency chain
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_AUTH=y
CONFIG_NVME_KEYRING=y
# Intel VMD — the RST "Volume Management Device" NVMe controller, DEFAULT-ON
# in firmware on 11th-gen+ Intel consumer laptops (first bite: Zephyrus M16
# i9-12900H, GE-01 pre-install eval 2026-07-05 — kernel saw ZERO NVMe devices,
# both drives invisible, Forge correctly enumerated empty). vmd exposes the
# PCI domain and the standard nvme driver binds behind it; =y per this file's
# no-initramfs invariant. Disabling VMD in firmware instead is NOT the answer:
# it strands an existing Windows install (RST-stack boot -> INACCESSIBLE_BOOT_DEVICE).
CONFIG_VMD=y
# Virtio (KVM/QEMU VMs)
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
# SCSI disk (required by USB_STORAGE, SATA, virtio-scsi)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# USB storage
CONFIG_USB_STORAGE=y
# Root filesystem
CONFIG_EXT4_FS=y
CONFIG_JBD2=y
# Device and partition infrastructure
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI_PARTITION=y

# --- UEFI ---
CONFIG_EFI_ESRT=y
CONFIG_EFI_CAPSULE_LOADER=m

# --- Display / GPU ---
# DISABLE the legacy EFI framebuffer (efifb). On a UEFI system whose GPU has no
# native KMS driver, efifb grabs the firmware framebuffer BEFORE simpledrm can
# register a DRM device — so /dev/dri/card0 never appears, and our Wayland-only
# GNOME (mutter) cannot start a display (GDM core-dump crash-loop → blank screen
# at graphical.target). Disabling efifb lets simpledrm (=y) own the EFI/GOP
# framebuffer and expose /dev/dri/card0 (fbcon still works via DRM_FBDEV_EMULATION=y).
# This is the universal "always reach a desktop via llvmpipe" fix — it covers
# VirtualBox VMSVGA AND any bare-metal UEFI box lacking a built-in KMS driver.
# CONFIG_FB_EFI is not set
# With efifb gone, name the sysfb simple-framebuffer device EXPLICITLY: on EFI,
# sysfb registers the "simple-framebuffer" platform device (which simpledrm binds
# for /dev/dri/card0) ONLY when SYSFB_SIMPLEFB is set. SYSFB=y is already on, but
# SYSFB_SIMPLEFB defaults off and olddefconfig would drop it — leaving NO fb at all
# once FB_EFI is removed. Name it; don't lean on the default.
CONFIG_SYSFB_SIMPLEFB=y
# Native KMS for the VMware/VirtualBox VMSVGA adapter ([15ad:0405], VBox default)
# → accelerated /dev/dri in VBox/VMware. Built-in (=y) by requirement: a
# module could fail to autoload in some path (initramfs omission / udev-coldplug
# race / modalias gap) and inhibit the accelerated display; =y binds at the
# earliest point. DRM_TTM promoted to =y here to satisfy the =y vmwgfx build
# (vmwgfx selects DRM_TTM); the existing =m DRM drivers depend on it fine.
CONFIG_DRM_TTM=y
CONFIG_DRM_VMWGFX=y

# --- Hypervisor guest support (all-hypervisor coverage) ---
# QEMU/KVM/Proxmox (full virtio set) and Xen (PV frontends) are already covered
# in the baseline. These add the Microsoft Hyper-V synthetic devices and the
# VMware + VirtualBox paravirtual/guest sets so InterGenOS boots, reaches the
# desktop, AND has working guest integration on every major hypervisor out of the
# box. All hypervisor-gated (dormant on bare metal; the PCI/VMBus device never
# appears otherwise). ALL built-in (=y) by requirement — if a module could
# in ANY path fail to load (initramfs omission, udev/coldplug timing, modalias gap)
# and thereby inhibit the device, it is =y instead. =y guarantees every guest
# driver is present and binds at the earliest point. Helper deps promoted to =y to
# satisfy the build: DRM_TTM (above), VSOCKETS (here), DRM_KMS_HELPER (GPU section);
# remaining DRM helper selects (TTM_HELPER / GEM_SHMEM_HELPER / DISPLAY_HELPER)
# auto-promote via Kconfig `select` at olddefconfig. Symbols verified present in
# the built 6.18 config.
#
# Microsoft Hyper-V (VMBus/IOMMU/timer/keyboard already =y in baseline).
# SCSI_FC_ATTRS promoted =m->=y: HYPERV_STORAGE=y has `depends on m || SCSI_FC_ATTRS
# != m` in 6.18.10 — kconfig caps storvsc at =m while the FC transport class is a
# module (a =y driver cannot link a =m transport class). Same promotion pattern as
# VSOCKETS->HYPERV_VSOCKETS below. FC attrs are dormant without FC hardware.
CONFIG_SCSI_FC_ATTRS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_UTILS=y
# VSOCKETS promoted =m->=y: HYPERV_VSOCKETS=y depends on it (a =y driver cannot
# depend on a =m core). The =m vsock transports (VIRTIO_VSOCKETS) depend on it fine.
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_DRM_HYPERV=y
# VMware (ESXi / Workstation / Fusion) paravirtual guest.
CONFIG_VMWARE_PVSCSI=y
CONFIG_VMXNET3=y
CONFIG_VMWARE_VMCI=y
# VMWARE_BALLOON depends on VMWARE_VMCI (enabled above) + X86 + HYPERVISOR_GUEST.
CONFIG_VMWARE_BALLOON=y
CONFIG_MOUSE_PS2_VMMOUSE=y
# VirtualBox guest. Two display paths, both shipped =y so VBox "boot it and try
# us out" works out of the box:
#   - DRM_VMWGFX above drives the VMSVGA controller (VBox default).
#   - DRM_VBOXVIDEO is VBox's NATIVE in-tree guest GPU driver for the VBoxSVGA
#     controller — dynamic auto-resize (guest follows the window) + a real EDID
#     (so GNOME auto-scales the greeter; fixes the 4K-greeter-tiny case), with NO
#     Oracle Guest Additions (an out-of-tree blob our sig_enforce=Y + integrity-
#     lockdown reject anyway). =y for the same reason as the rest of the guest
#     set: a built-in cannot fail to coldplug before GDM. It selects
#     DRM_KMS_HELPER (=y above) + DRM_VRAM_HELPER / DRM_TTM (=y) / DRM_TTM_HELPER /
#     DRM_CLIENT_SELECTION / GENERIC_ALLOCATOR, which auto-promote =y via Kconfig
#     `select` at olddefconfig (verified against drivers/gpu/drm/vboxvideo/Kconfig
#     for 6.18.10). Keep DRM_VMWGFX too (real VMware). (WC GBC0041 eval + thread
#     vbox-native-driver-drm-vboxvideo-2026-06-19.)
# Guest integration core (guest properties / time sync / clipboard hooks) +
# shared folders below.
CONFIG_DRM_VBOXVIDEO=y
CONFIG_VBOXGUEST=y
CONFIG_VBOXSF_FS=y

# --- systemd requirements ---
CONFIG_CGROUP_MEMORY=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_BPF=y

# --- Network drivers (additional coverage) ---
CONFIG_BNXT_EN=m
CONFIG_ATLANTIC=m
CONFIG_RTW88_PCI=m
CONFIG_RTW89_PCI=m
CONFIG_MT76=m

# --- GPU ---
# =y (promoted from =m): the built-in hypervisor display drivers (DRM_VMWGFX,
# DRM_HYPERV) select DRM_KMS_HELPER, so it must be =y to satisfy a =y selector;
# the existing =m DRM drivers (AMDGPU/RADEON/QXL/VIRTIO_GPU/BOCHS) depend on it
# fine as a built-in.
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_RADEON=m
CONFIG_BACKLIGHT_GENERIC=m

# --- USB ---
# USB_STORAGE already set =y in Storage section above
CONFIG_USB_UAS=y
CONFIG_THUNDERBOLT=m

# --- Input ---
CONFIG_MOUSE_PS2=y
# HID_GENERIC promoted =m->=y (baseline ships =m). hid-generic is the universal
# catch-all HID->input driver: with USB_HID=y (the USB-HID transport, already
# built in) it is what turns a plain USB keyboard/mouse into working input. As a
# MODULE it must be bundled into AND modprobe'd from the FDE busybox initramfs
# (there is no udev coldplug there to auto-bind it) — a fragile chain whose
# failure leaves a user whose ONLY keyboard is USB unable to type the LUKS
# passphrase: a silent lockout from their own encrypted disk -- the worst, most
# user-hostile failure mode in the boot path. Built in, hid-generic is present in EVERY
# boot context (FDE initramfs, recovery shell, the LUKS prompt) with zero
# bundling/modprobe dependency. ONE small catch-all driver only — the
# device-specific HID drivers (HID_LOGITECH*, HID_APPLE, ...) stay =m, so no bloat
# (no distro =y's the whole HID subsystem; only the generic fallback). Built-in
# i8042/atkbd keyboards already worked; this closes the USB-keyboard-only gap.
# Root-caused on the A12 (GBC004.2/.3, 2026-06-21): a USB-only keyboard would not
# reach the passphrase prompt able to type it.
CONFIG_HID_GENERIC=y

# --- Sound ---
CONFIG_SND_TIMER=m
CONFIG_SND_PCM=m
CONFIG_SND_MIXER_OSS=m
CONFIG_SND_PCM_OSS=m

# --- Bluetooth drivers ---
CONFIG_BT_INTEL=m
CONFIG_BT_BCM=m
CONFIG_BT_HCIUART=m
CONFIG_BT_RTL=m
CONFIG_BT_QCA=m

# --- Firewall / Netfilter ---
# InterGenOS uses nftables exclusively. Legacy xtables interface is
# explicitly disabled so userspace iptables-legacy cannot bind to it.
# iptables-nft userspace (CLI compat shim translating to nft rules) is
# the supported migration path for users with iptables muscle memory.
# See: docs/research/networking/nftables_only_decision.md (Track 2)
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
# Explicitly disable legacy xtables interface (HG Rule #4 — every package
# is a security decision; one firewall framework = smaller attack surface)
# CONFIG_NETFILTER_XTABLES_LEGACY is not set
# Modern netfilter API entry points (kept for nftables-backed compat)
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_TABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y

# --- Forge Secure Boot (kernel signing) ---
# Per the kernel-module-signing design (see docs/ephemeral-module-signing.md):
# - MODULE_SIG=y + MODULE_SIG_ALL=y already in baseline
# - SECONDARY_TRUSTED_KEYRING=y already in baseline (MOK chain)
# - MODULE_SIG_KEY intentionally UNSET — kernel build auto-generates
#   ephemeral keypair per build, embeds pubkey in matched vmlinuz
# - HG requires HARD REJECT of unsigned modules (not just sign-and-warn)
CONFIG_MODULE_SIG_FORCE=y
# CONFIG_MODULE_SIG_KEY is not set

# --- Security ---
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# Default kernel lockdown = integrity, engaged unconditionally from early boot
# (paired with CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y above).
#
# NOTE: the old CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT (auto-engage lockdown when
# EFI Secure Boot is *detected* at runtime) is a DOWNSTREAM distro patch
# (Fedora/SUSE/Debian carry it — hence its presence in our reference configs at
# fedora.config:4044 / opensuse:11462). It is NOT in vanilla kernel.org mainline:
# verified absent from the genuine, checksum-matched 6.18.10 source (zero hits
# tree-wide; arch/x86/kernel/setup.c only pr_info()s the SB state, and no
# lock_kernel_down() call exists in-tree). We build vanilla, so we use the
# in-tree mechanism instead: FORCE_INTEGRITY boots the kernel locked-down
# (LOCKDOWN_INTEGRITY) every time. Because InterGenOS mandates Secure Boot and
# ships a sealed UKI cmdline, "always locked down" is strictly stronger and more
# deterministic than runtime-SB-detection coupling — and stays patch-free
# (PRIME DIRECTIVE: transparent, no out-of-tree glue). Supersedes the Q17
# auto-engage gap (channel 2026-04-29T18:00:15Z); migrated to the vanilla-native
# mechanism 2026-06-02 (first kernel-phase run, caught by the Audit D-1 gate).
# CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE is not set
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y

# Explicit LSM init order — without this, lockdown may initialize too late
# (after kernel modules load) and partially defeat the FORCE_INTEGRITY lockdown
# guarantee above. AppArmor appended per design decision 4-0 unanimous A on
# 2026-04-29 (v1.0 default major LSM, complain-mode profiles). The
# `packages/core/apparmor/` profile set ships substrate (Debian
# apparmor-profiles-extra) plus three custom profiles for
# intergen-mcp / pkm / forge-sb-installer.
# Cite: prior code-audit K2, Fedora reference at line CONFIG_LSM=
# (`docs/research/kernel_configs/fedora.config`).
CONFIG_LSM="lockdown,yama,integrity,bpf,landlock,apparmor"

# Default major LSM. Without this, AppArmor compiles into the kernel + loads
# at boot but doesn't activate as the active major LSM. Setting it to
# "apparmor" ensures the LSM is the runtime-active major LSM on every boot
# (matching Ubuntu/SUSE shipping pattern).
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY="apparmor"

# IMA (Integrity Measurement Architecture) auto-activate under Secure Boot.
# Same Q17 pattern as LOCK_DOWN_IN_EFI_SECURE_BOOT above — feature compiled in
# but didn't auto-activate without these flags. Fedora ships all of these =y.
# Cite: DeepSeek code-audit K3 + HIGH list, 2026-04-29T20:04Z dispatch.
CONFIG_IMA_SECURE_AND_OR_TRUSTED_BOOT=y
CONFIG_IMA_ARCH_POLICY=y
CONFIG_IMA_APPRAISE_BOOTPARAM=y
CONFIG_IMA_APPRAISE_MODSIG=y
CONFIG_IMA_NG_TEMPLATE=y
CONFIG_IMA_LSM_RULES=y
CONFIG_IMA_QUEUE_EARLY_BOOT_KEYS=y
CONFIG_IMA_KEYRINGS_PERMIT_SIGNED_BY_BUILTIN_OR_SECONDARY=y

# FIPS-mode infrastructure compiled in (default-off; users opt in via fips=1
# kernel cmdline). Distinct from "FIPS-validated" — InterGenOS is NOT pursuing
# actual FIPS validation, just enabling the option for users in regulated
# environments. Costs ~few KB binary + microseconds of boot self-test.
# Cite: DeepSeek code-audit HIGH list, owner-vote-YES 2026-04-29 evening.
CONFIG_CRYPTO_FIPS=y

# --- Device-mapper / dm-verity (root integrity) ---
# The dm-verity boot path (init.sh) and the UKI assume dm-verity is BUILT-IN so
# root-integrity verification engages before any module loads. Two symbols are
# needed for that, and BOTH are stated here rather than relied upon elsewhere:
#
#   BLK_DEV_DM=y  — the distro-convergence derivation emits =m. `make
#     olddefconfig` cannot keep a built-in (=y) symbol whose dependency is only
#     a module (=m), so a =m dependency silently downgrades DM_VERITY to =m.
#   DM_VERITY=y   — the derivation also emits =m, because the majority of the
#     surveyed distros ship dm-verity as a module. InterGenOS does not: the
#     verified-root guarantee is not optional here.
#
# This fragment is concatenated AFTER the baseline, so both win in olddefconfig.
#
# Decided 2026-08-07: DM_VERITY=y is stated HERE because
# 00-universal-baseline.config is now a PURELY GENERATED artifact, reproduced
# byte-for-byte by docs/research/kernel_configs/analyze_convergence.py. It
# previously carried a hand edit flipping this one line to =y, which meant a
# routine regeneration of the baseline would silently destroy a root-integrity
# guarantee while the build still succeeded. A security guarantee must not
# depend on a hand edit inside a file a generator overwrites.
#
# The post-merge assertion in packages/core/linux-kernel/build.sh HARD-FAILs if
# any of these load-bearing symbols drift. Audit D-1 (2026-05-29): the
# corrective fragment had been left in
# config/kernel/fragments/archive/01-storage.config, which the build's
# `fragments/*.config` glob never loads.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# --- AF_ALG kernel-crypto userspace API (veritysetup / cryptsetup backend) ---
# The static veritysetup (live-ISO dm-verity open) and cryptsetup (FDE LUKS
# unlock) are both built --with-crypto_backend=kernel — they reach the kernel's
# crypto algorithms through the AF_ALG socket family at library-init time. The
# baseline ships these AF_ALG interfaces as MODULES (CONFIG_CRYPTO_USER_API_*=m,
# 00-universal-baseline.config:331-334). Inside the initramfs envelope — where a
# module must be physically present in the cpio AND modprobed before the binary
# runs — veritysetup's crypt_backend_init() cannot open its AF_ALG hash socket
# and dies with "Cannot initialize crypto backend", failing the squashfs
# integrity check (the trust-critical live-root verification). Exact same
# integrity-engages-before-any-module-loads reasoning as DM_VERITY above: force
# the AF_ALG interfaces BUILT-IN so the crypto backend is unconditionally present
# in early boot. HASH is what dm-verity open needs; SKCIPHER is what the FDE LUKS
# keyslot decrypt needs; CRYPTO_USER_API is the af_alg core both select.
# CONFIG_CRYPTO_SHA256=y (baseline:323) already supplies the hash algorithm.
# Post-merge assertion in packages/core/linux-kernel/build.sh HARD-FAILs on drift.
# (2026-06-02: root-caused from the first bare-metal boot — dm-verity open
# failed at "Cannot initialize crypto backend" because these were =m.)
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# --- Hyper-V guest: the VMBus PARENT symbol ---
# Decided 2026-08-07. Every Hyper-V guest driver the build asserts at =y
# (HYPERV_STORAGE, HYPERV_NET, HID_HYPERV_MOUSE, HYPERV_BALLOON, HYPERV_UTILS,
# HYPERV_VSOCKETS, DRM_HYPERV) depends on HYPERV_VMBUS, and a symbol can only be
# built in when its dependencies are. HYPERV_VMBUS is declared `default HYPERV`,
# so while nothing stated it explicitly it quietly inherited HYPERV's value and
# the =y assertions passed by luck rather than by statement. The moment the
# baseline began stating it explicitly (it lives in drivers/hv, so the hardware
# union emits it as a module) every one of those seven silently dropped to =m
# and the build's own assertion loop caught all seven at once.
#
# Same shape as the MMC defect this cut fixes: an unstated PARENT quietly
# governing a set of dependents. State the parent.
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y

# --- KVM guest (VM support) ---
CONFIG_PARAVIRT_GUEST=y
CONFIG_VIRTIO_PCI_MODERN=y

# --- KVM host (hypervisor) ---
CONFIG_VFIO_IOMMU_TYPE1=m
CONFIG_IOMMU_API=y
CONFIG_VHOST=m
CONFIG_KVM_AMD_SEV=y

# --- IoT/Smart Home ---
CONFIG_I2C_GPIO=m
CONFIG_SPI_SPIDEV=m
CONFIG_SPI_GPIO=m
CONFIG_GPIO_CHARDEV=y
CONFIG_W1_GPIO=m
CONFIG_W1_THERM=m
CONFIG_NFC_PN533=m

# --- HP Laptop specific (from Arch config / kernel briefing) ---
# Intel SOF audio (Ice Lake)
CONFIG_SND_SOC_CORE=m
CONFIG_SND_SOC_ACPI=m
CONFIG_SND_SOC_ACPI_INTEL_MATCH=m
CONFIG_SND_HDA_EXT_CORE=m
CONFIG_SND_INTEL_DSPCFG=m
CONFIG_SND_INTEL_SDW_ACPI=m
CONFIG_SND_SOF=m
CONFIG_SND_SOF_PCI=m
CONFIG_SND_SOF_INTEL_ICL=m

# RTW88 WiFi — bus-level parents MUST be set or sub-drivers get silently disabled
CONFIG_RTW88_CORE=m
CONFIG_RTW88_PCI=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_SDIO=m
CONFIG_RTW88_8821C=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8723DE=m

# RTW89 WiFi (newer Realtek chips)
CONFIG_RTW89=m
CONFIG_RTW89_CORE=m
CONFIG_RTW89_PCI=m

# Intel GPU force probe
CONFIG_DRM_I915_FORCE_PROBE="*"
CONFIG_SND_HDA_I915=y

# Intel LPSS (I2C touchpad on modern laptops)
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_PINCTRL_INTEL=y
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_HID_ACPI=m

# --- Intel per-SoC pin controllers (REQUIRED for I2C-HID touchpads) ---
# Decided 2026-08-07, proven end-to-end on real hardware before landing.
#
# CONFIG_PINCTRL_INTEL=y above is only the SHARED CORE library. It registers no
# device of its own. Every Intel SoC generation has a SEPARATE per-generation
# driver carrying the ACPI match table for that generation's pin controller, and
# without the matching one the pin controller is claimed by nothing, so its GPIO
# lines have no irqchip. An I2C-HID touchpad's interrupt IS one of those GPIO
# lines, so i2c_hid_acpi cannot resolve its IRQ and the device sits on the
# deferred-probe list forever, silently, with a working I2C bus underneath it.
#
# MEASURED on a 12th-gen Core i5-12450H laptop whose firmware exposes pin
# controller INTC1055 with none of these drivers built:
#   /sys/kernel/debug/devices_deferred  ->  "i2c-ELAN0788:00  i2c_hid_acpi:
#                                            can't get irq"   (touchpad dead)
#   ACPI device INTC1055:00 present and enabled, bound to NO driver
#   no touchpad in /proc/bus/input/devices at all
# Building the driver whose match table claims INTC1055 and loading it cleared
# the deferred list to zero, bound i2c-ELAN0788:00 to i2c_hid_acpi, and created
# a real multitouch touchpad input device (hid-multitouch, 123x78 mm). Nothing
# else changed.
#
# NOTE ON SELECTION: the driver is chosen by the ACPI ID the FIRMWARE exposes,
# NOT by the CPU's marketing generation. The measured machine is an Alder Lake
# CPU whose pin controller answers to INTC1055 — an ID that lives in the TIGER
# LAKE driver's match table, not the Alder Lake one. Picking the driver by CPU
# codename would have built the wrong one. That is precisely why the whole
# generation range is enabled here rather than a guessed subset: which single
# driver a given board needs is not predictable from the CPU name.
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_PINCTRL_BROXTON=m
CONFIG_PINCTRL_CANNONLAKE=m
CONFIG_PINCTRL_CEDARFORK=m
CONFIG_PINCTRL_DENVERTON=m
CONFIG_PINCTRL_ELKHARTLAKE=m
CONFIG_PINCTRL_EMMITSBURG=m
CONFIG_PINCTRL_GEMINILAKE=m
CONFIG_PINCTRL_ICELAKE=m
CONFIG_PINCTRL_JASPERLAKE=m
CONFIG_PINCTRL_LAKEFIELD=m
CONFIG_PINCTRL_LEWISBURG=m
CONFIG_PINCTRL_LYNXPOINT=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_PINCTRL_METEORPOINT=m
CONFIG_PINCTRL_SUNRISEPOINT=m
CONFIG_PINCTRL_TIGERLAKE=m
CONFIG_PINCTRL_INTEL_PLATFORM=m

# --- Elantech / I2C touchpads ---
# Elantech touchpads (very common on HP / Asus / Acer laptops) and other
# I2C touchpads ride the SMBus path when MOUSE_ELAN_I2C_SMBUS is set —
# without it the kernel falls back to the older PS/2 protocol and prints
# "elantech: The touchpad can support a better bus than the too old PS/2
# protocol." Pairs with MOUSE_PS2_ELANTECH_SMBUS=y already above.
# Decided 2026-08-07: moved here from 00-universal-baseline.config, which is
# now a purely generated artifact — see the dm-verity note above for why a
# hand edit must not live inside a file a generator overwrites.
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y

# --- MMC / SD card reader ---
# Decided 2026-08-07. The distro-convergence baseline requests THIRTEEN
# CONFIG_MMC_* host-controller drivers but never requests the parent symbol
# they all live under (`menuconfig MMC` in drivers/mmc/Kconfig). `make
# olddefconfig` therefore discards all thirteen without a word and writes
# "# CONFIG_MMC is not set" — which is exactly what the shipped kernel carries,
# and why the SD card reader on a measured machine is dead while the recipe
# looks like it asked for it. This is the olddefconfig silent-drop class: the
# request was made and was silently refused for an unstated dependency.
# The post-merge assertion in packages/core/linux-kernel/build.sh now covers
# MMC so a repeat is a BUILD FAILURE rather than a silent shipment.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_MMC_SDHCI_PLTFM=m
CONFIG_MMC_REALTEK_PCI=m
CONFIG_MISC_RTSX=m
CONFIG_MISC_RTSX_PCI=m

# CPU microcode loading (audit E-001 fix, 2026-05-18, revised 2026-05-18 evening)
#
# Kernel 6.18 refactored the microcode Kconfig: the previous independent
# symbols `CONFIG_MICROCODE_INTEL` and `CONFIG_MICROCODE_AMD` no longer
# exist as separate options. The 6.18 Kconfig replaces them with a
# vendor-detection chain: `MICROCODE` now `depends on CPU_SUP_AMD ||
# CPU_SUP_INTEL`. olddefconfig silently drops the obsolete vendor flags
# if anyone (us included) tries to set them.
#
# Audit E-001 originally identified `CONFIG_MICROCODE_INTEL` /
# `CONFIG_MICROCODE_AMD` as the missing flags — that diagnosis was
# accurate for pre-6.18 kernels, but is structurally stale on 6.18.10.
# The actual chain we need for working early-boot microcode load on 6.18
# is:
#   - CPU_SUP_INTEL=y AND CPU_SUP_AMD=y  (both required: Intel +
#     AMD CPU support compiled in so MICROCODE's dependency is satisfied
#     for both vendors)
#   - MICROCODE=y                        (loader, depends on at least
#     one CPU_SUP_* — already set in 00-universal-baseline.config)
#   - MICROCODE_LATE_LOADING=y           (runtime microcode updates)
#
# Verified 2026-05-18 19:29Z post-kernel-rebuild: `dmesg | grep
# microcode` shows "microcode: Updated early from: 0x000000a8 ->
# Current revision: 0x000000c6" with this chain active. The pre-fix
# vmlinuz had NO microcode line in dmesg at all.
#
# x86_64 defconfig already has CPU_SUP_INTEL=y + CPU_SUP_AMD=y at
# baseline, so these would survive olddefconfig from /dev/null. We
# state them explicitly here as load-bearing-policy declarations:
# anyone editing the baseline who would otherwise =n CPU_SUP_AMD
# (e.g. an Intel-only build optimization) would break microcode-loading
# on AMD hosts. This file is the InterGenOS policy that we ship a
# vendor-neutral image.
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_MICROCODE_LATE_LOADING=y

# --- FAT/VFAT default IO charset (GBC001.9) ---
# The baseline ships CONFIG_NLS_ISO8859_1=m. FAT mounts default to
# iocharset=iso8859-1, but at early boot the kernel probes the ESP /
# any FAT partition (e.g. the live USB's sda1) BEFORE the nls_iso8859-1
# module can be auto-loaded -> "FAT-fs (sda1): IO charset iso8859-1 not
# found" in dmesg (observed on the GBC001.2 boot). Cosmetic on the live
# ISO (sda1 isn't mounted at runtime), but the default charset should be
# built in so FAT/VFAT mounts always resolve it. Builds it in (=y).
# NOTE: kernel-config change — lands only on a full kernel rebuild
# (the GBC002 from-scratch cycle), NOT a --start-at squashfs resume.
CONFIG_NLS_ISO8859_1=y

# --- DRM panic-screen QR code (Zephyrus panic post-mortem, 2026-07-08) ---
# CONFIG_DRM_PANIC=y already renders the panic screen (observed on the
# .200 fault: Tux + "kernel panic" on both DRM heads), but without the
# QR option the on-screen data is only what a human transcribes. With
# DRM_PANIC_SCREEN_QR_CODE=y the panic screen embeds the kmsg panic
# record in a QR code, so ONE phone photo captures the full panic even
# when pstore cannot (decided GO, 2026-07-08 night; tracker row
# "panic record extracted" in the private ledger). URL scheme left at
# the upstream default.
# NOTE: kernel-config change — lands only on a full kernel rebuild,
# NOT a --start-at squashfs resume.
CONFIG_DRM_PANIC_SCREEN_QR_CODE=y

# --- AMD KFD / ROCm compute (GPU-engine plan, operator-GO'd 2026-07-09) ---
# ROCm/HIP (the 35B MoE's real path + the dogfooding-workstation compute
# lane) requires the amdgpu KFD compute interface: without CONFIG_HSA_AMD
# there is no /dev/kfd and the ROCm userspace cannot run at all. Vulkan
# does NOT need this (it rides the existing amdgpu DRM node) — this is the
# ROCm-only kernel half, landed ahead of the compute-tier userspace so the
# next from-scratch kernel carries it. Prereqs already in the baseline:
# DRM_AMDGPU_USERPTR / HMM_MIRROR / DEVICE_PRIVATE (verified 2026-07-09).
# SVM adds shared-virtual-memory support KFD uses on RDNA3.
# NOTE: kernel-config change — lands only on a full kernel rebuild
# (the from-scratch burn), NOT a --start-at squashfs resume.
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_SVM=y

# --- CPU thermal sensor (thermal-visibility fix, decided 2026-07-21) ---
# The baseline carries HWMON=y and the Super-I/O fan drivers (NCT6775=m et
# al.) but NO CPU temperature driver for AMD Zen: without SENSORS_K10TEMP
# there is no CPU temp on any hwmon consumer (sensors CLI, GUIs, telemetry)
# on the AMD platforms this OS primarily targets. Module, not builtin —
# loads on matching PCI IDs automatically. Evidence-based single addition;
# Intel coretemp is already =m in the baseline class if/when needed.
# NOTE: kernel-config change — lands only on a full kernel rebuild
# (the ch10 driver leg + the single-kernel gate), NOT a squashfs resume.
CONFIG_SENSORS_K10TEMP=m
