#
# intergen-welcome-privhelper — privileged "Enable Services" and name-server
# actions for the Welcomer. The privileged verbs are invoked ONLY via pkexec,
# which authenticates the caller as an administrator (prompts for the password)
# and runs this as root.
#
# SECURITY MODEL (security-only alignment):
#   * pkexec's built-in org.freedesktop.policykit.exec action is auth_admin —
#     it ALWAYS prompts for the administrator password. We deliberately do NOT
#     ship a custom polkit rule that could weaken that to allow_active=yes; the
#     default is the safe one, so no .rules / .policy file is needed.
#   * This helper accepts EXACTLY ONE verb from the fixed whitelist below and
#     nothing else. No caller-supplied paths, names, or service strings are
#     ever interpolated into a command — so there is no injection surface.
#   * The user added to `lpadmin` is derived from $PKEXEC_UID (pkexec sets it
#     to the calling uid; it is not attacker-controlled), never from an arg.
#   * Every action is fully reversible by its `disable-` counterpart: the
#     service is disabled and any firewall drop-in this helper wrote is removed.
#
# THE ONE CALLER-SUPPLIED VALUE, and how it is contained: `dns-use-custom`
# takes name-server ADDRESSES, because a user who runs their own resolver has
# to be able to name it. That value is validated HERE, at the privileged
# boundary, not in the unprivileged interface that sends it — an interface can
# be bypassed, this cannot. It is accepted only if it parses as a literal IPv4
# or IPv6 address by this script's own parsers (no external command sees it),
# and it is written into a configuration file with printf. It never reaches a
# command line, a shell expansion, or an eval. The charset gate inside the
# parsers additionally makes it impossible for an accepted value to contain a
# newline, an `=` or a `[`, so an accepted value cannot introduce a second
# configuration directive into the file it is written to.
#
# `check-address` is the same validation with NOTHING else attached: it takes
# an address, writes nothing, touches nothing, and exits 0 or 2. The Welcomer
# runs it directly (no pkexec) to tell the user their address is malformed
# before asking them for a password, so the check the interface shows and the
# check the privileged write enforces are the same code.
#
# Firewall: the discovery/ssh verbs drop a removable fragment into
# /etc/nftables.d/ (which intergenos-firewall-defaults' nftables.conf includes)
# and reload nftables. The shipped default-deny ruleset is never edited in
# place; toggling a service off deletes its fragment. This is the "drop-in
# rule / GUI control panel" path D-011 explicitly anticipates.
#
# Name servers: the dns-* verbs use the same removable-fragment shape — a
# drop-in under /etc/systemd/resolved.conf.d/. The network's own configuration
# is never edited, and `dns-use-network-default` deletes the fragment, which
# returns the machine exactly to what the network hands out.
set -euo pipefail

NFTD=/etc/nftables.d
MDNS_DROPIN="$NFTD/50-intergen-mdns.conf"
SSH_DROPIN="$NFTD/40-intergen-ssh.conf"

RESOLVED_CONF_D=/etc/systemd/resolved.conf.d
DNS_DROPIN="$RESOLVED_CONF_D/50-intergen-welcome-dns.conf"

NSSWITCH=/etc/nsswitch.conf

# The IPP-over-USB daemon's configuration. It advertises the printer it serves
# over DNS-SD only when this file says so, and this file says so only while the
# machine's own mDNS responder is turned on — the Welcomer's Network Discovery
# choice governs both, because they are the same decision: whether this machine
# announces things about itself.
IPP_USB_CONF=/etc/ipp-usb/ipp-usb.conf

# The two forms of the name-service-switch hosts line this helper moves between.
# OFF is the line glibc-core ships. ON is the SAME entries with mdns4_minimal
# moved ahead of resolve. Nothing is added and nothing is removed — only the
# position of an entry the system already ships changes.
HOSTS_LINE_OFF='hosts: mymachines resolve [!UNAVAIL=return] files myhostname dns mdns4_minimal [NOTFOUND=return]'
HOSTS_LINE_ON='hosts: mymachines mdns4_minimal [NOTFOUND=return] resolve [!UNAVAIL=return] files myhostname dns'

# Installs made before 2026-09-14 carried the install-time SSH opt-in as an
# inline rule in the shipped /etc/nftables.conf instead of the fragment above.
# Turning SSH off must close the port on those machines too, so the exact
# three-line block the old installer inserted is removed here (and nowhere
# else: the shipped file is otherwise never edited). Matched by its full text,
# so a hand-written rule with a different comment is left alone.
strip_legacy_ssh_rule() {
    local f="${1:-/etc/nftables.conf}"
    [ -f "$f" ] || return 0
    grep -qF '# SSH server (opt-in via Forge install per D-019)' "$f" || return 0
    python3 - "$f" <<'PY'
import sys
p = sys.argv[1]
block = ("        # SSH server (opt-in via Forge install per D-019)\n"
         "        tcp dport 22 accept\n\n")
t = open(p).read()
if block in t:
    open(p, "w").write(t.replace(block, "", 1))
PY
}

reload_firewall() {
    mkdir -p "$NFTD"
    systemctl reload nftables 2>/dev/null \
        || systemctl restart nftables 2>/dev/null \
        || nft -f /etc/nftables.conf
}

caller_user() {
    local uid="${PKEXEC_UID:-}"
    if [ -n "$uid" ]; then
        getent passwd "$uid" | cut -d: -f1
    fi
}

# ---------------------------------------------------------------------------
# .local name resolution for the discovery toggle
#
# WHY THIS EXISTS. Avahi answers mDNS, so with discovery on the machine SEES a
# network printer: CUPS lists it and its queue address is the printer's .local
# name. Resolving that name is a separate step, and the shipped hosts line
# cannot do it: `resolve [!UNAVAIL=return]` hands the lookup to systemd-resolved
# and returns to the caller on any answer except "resolver unavailable", so the
# mdns4_minimal entry sitting after it is never reached. systemd-resolved has
# its own multicast DNS switched off — as it must be, because Avahi is the
# responder on this system and two responders cannot share udp/5353. The result
# is a machine that finds a printer it cannot address. Measured 2026-08-19 on a
# real install against a real IPP printer: discovery listed it, `getent hosts`
# returned nothing, and printing failed.
#
# WHY IT IS TIED TO THE TOGGLE INSTEAD OF SHIPPED AS THE DEFAULT. nss-mdns does
# not need Avahi to be running: with no Avahi socket it sends its own multicast
# query and waits for a reply. With discovery off, the firewall drops the
# replies, so every .local lookup on the machine would stall until nss-mdns
# gives up — measured at 10.0 seconds against 3 milliseconds when discovery is
# on. Shipping this order by default would trade one broken promise for a delay
# on a machine whose owner asked for neither. So the order is part of what the
# discovery toggle turns on, and `disable-discovery` puts it back.
#
# WHY IT EDITS A FILE INSTEAD OF DROPPING A FRAGMENT IN. Every other change this
# helper makes is a removable drop-in, because the subsystem supports one. The
# name-service switch has no drop-in directory: one file decides the order. So
# this is the one edit in place, and it is made as narrow as an edit can be —
# it rewrites one line, only when that line is exactly one of the two forms
# above, and it refuses to touch a hosts line it does not recognise rather than
# guessing at a file the owner has edited.
# ---------------------------------------------------------------------------

# mdns_hosts_line <on|off> — read a nsswitch.conf on stdin, print the hosts line
# it should have. Exit 0 if the file's hosts line is recognised (already right,
# or the other known form), 3 if it is not recognised, 2 on a bad argument.
# Writes nothing. The privileged verbs below and the `mdns-hosts-line` verb both
# go through this function, so the check the interface can run and the rewrite
# the helper performs cannot drift apart.
mdns_hosts_line() {
    local want="$1" line wanted
    case "$want" in
        on)  wanted="$HOSTS_LINE_ON" ;;
        off) wanted="$HOSTS_LINE_OFF" ;;
        *)   return 2 ;;
    esac
    line="$(grep -m1 '^hosts:' || true)"
    [ -n "$line" ] || return 3
    if [ "$line" = "$HOSTS_LINE_ON" ] || [ "$line" = "$HOSTS_LINE_OFF" ]; then
        printf '%s\n' "$wanted"
        return 0
    fi
    return 3
}

# set_mdns_hosts_order <on|off> — rewrite /etc/nsswitch.conf's hosts line.
# A hosts line that is neither known form is left alone and reported; the rest
# of the toggle still applies, because a machine that cannot resolve .local
# names is a lesser failure than a machine whose name lookups were rearranged
# behind its owner's back.
set_mdns_hosts_order() {
    local want="$1" wanted current tmp
    [ -f "$NSSWITCH" ] || { echo "intergen-welcome-privhelper: $NSSWITCH is absent; hosts order left unchanged" >&2; return 0; }
    if ! wanted="$(mdns_hosts_line "$want" < "$NSSWITCH")"; then
        echo "intergen-welcome-privhelper: the hosts line in $NSSWITCH is not one this helper wrote or ships; it was left exactly as it is" >&2
        return 0
    fi
    current="$(grep -m1 '^hosts:' "$NSSWITCH" || true)"
    [ "$current" != "$wanted" ] || return 0
    tmp="$(mktemp "${NSSWITCH}.XXXXXX")"
    chmod --reference="$NSSWITCH" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
    chown --reference="$NSSWITCH" "$tmp" 2>/dev/null || true
    awk -v repl="$wanted" '!done && /^hosts:/ { print repl; done=1; next } { print }' "$NSSWITCH" > "$tmp"
    mv -f "$tmp" "$NSSWITCH"
}

# ---------------------------------------------------------------------------
# Address validation
#
# Parsed in bash on purpose. This is the only value the helper accepts from its
# caller, so it is examined by this script rather than handed to another
# program: nothing else ever sees the string until it has been accepted, and an
# accepted string is written with printf, never executed.
#
# Both parsers begin by refusing every character outside their own alphabet.
# That gate is what guarantees an accepted address cannot carry a newline, an
# `=` or a `[`, and therefore cannot turn one configuration line into two.
# ---------------------------------------------------------------------------

# valid_ipv4 <string> — true for a dotted-quad literal.
# Leading zeros are refused: "010" is ten to systemd and eight to anything that
# reads it as octal, and an address that means two different things to two
# readers has no place in a file that decides where name lookups go.
valid_ipv4() {
    local address="$1" octet
    [[ "$address" =~ ^[0-9.]+$ ]] || return 1
    [[ "$address" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    local IFS=.
    local -a octets
    read -r -a octets <<< "$address"
    [ "${#octets[@]}" -eq 4 ] || return 1
    for octet in "${octets[@]}"; do
        [ -n "$octet" ] || return 1
        [ "${#octet}" -le 3 ] || return 1
        if [ "${#octet}" -gt 1 ] && [ "${octet:0:1}" = "0" ]; then
            return 1
        fi
        [ "$octet" -le 255 ] || return 1
    done
    return 0
}

# _ipv6_run_groups <run> <allow-trailing-ipv4:yes|no> — echoes the number of
# 16-bit groups a colon-separated run represents, or returns 1 if any group is
# malformed. An empty run is zero groups (that is what sits either side of a
# "::"). The embedded-IPv4 form is accepted only where it is legal — as the
# last group of the WHOLE address — which is why the caller has to say so:
# "1.2.3.4::" is not an address, and a run-local check would accept it.
_ipv6_run_groups() {
    local run="$1" allow_trailing_ipv4="$2" group count=0 index=0 last
    if [ -z "$run" ]; then
        echo 0
        return 0
    fi
    local IFS=:
    local -a groups
    read -r -a groups <<< "$run"
    last=$(( ${#groups[@]} - 1 ))
    for group in "${groups[@]}"; do
        if [[ "$group" == *.* ]]; then
            if [ "$allow_trailing_ipv4" != "yes" ] || [ "$index" -ne "$last" ]; then
                return 1
            fi
            valid_ipv4 "$group" || return 1
            count=$(( count + 2 ))
        else
            [[ "$group" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
            count=$(( count + 1 ))
        fi
        index=$(( index + 1 ))
    done
    echo "$count"
    return 0
}

# valid_ipv6 <string> — true for a literal IPv6 address, compressed or not.
# Zone identifiers ("fe80::1%eth0") are refused: a link-local name server is
# not something this page offers, and the percent form would have to survive
# into a configuration file whose parser may read it differently.
valid_ipv6() {
    local address="$1" head tail head_groups tail_groups
    [[ "$address" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
    [[ "$address" == *:* ]] || return 1
    case "$address" in
        *::*::*) return 1 ;;
    esac
    # A single leading or trailing colon is only legal as part of "::".
    case "$address" in
        ::*|*::) : ;;
        :*|*:) return 1 ;;
    esac

    if [[ "$address" == *::* ]]; then
        head="${address%%::*}"
        tail="${address#*::}"
        head_groups="$(_ipv6_run_groups "$head" no)" || return 1
        tail_groups="$(_ipv6_run_groups "$tail" yes)" || return 1
        # "::" must stand for at least one omitted group, so a compressed
        # address can never already carry all eight.
        [ $(( head_groups + tail_groups )) -lt 8 ] || return 1
        return 0
    fi

    head_groups="$(_ipv6_run_groups "$address" yes)" || return 1
    [ "$head_groups" -eq 8 ] || return 1
    return 0
}

# valid_address <string> — true for either family.
valid_address() {
    valid_ipv4 "$1" || valid_ipv6 "$1"
}

# ---------------------------------------------------------------------------
# Name-server selection
#
# The addresses below carry `#name` suffixes. That name is the certificate name
# systemd-resolved validates when it opens the encrypted connection — without
# it, DNS-over-TLS to an IP address has nothing to check the certificate
# against. These are the same names the shipped fallback list already uses.
# ---------------------------------------------------------------------------

CLOUDFLARE_SERVERS='1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com'
QUAD9_SERVERS='9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net'

# systemd-resolved has no reload path (its unit declares no ExecReload), so a
# configuration change is picked up by a restart. The restart is NOT tolerated
# if it fails: a caller that is told the change was applied must be able to
# rely on that, so a failure here fails the whole verb.
restart_resolved() {
    systemctl restart systemd-resolved
}

# selection_from_dropin — read a name-server drop-in on STDIN, print the verb
# that would apply the same choice again.
#
# WHY THIS EXISTS. Every machine already in the field chose its name server
# before this helper learned to do the rest of what that choice needs. The
# repair has to know WHICH choice was made, and the only record of it is the
# `Selection:` line in the drop-in this helper writes. So the reading is split
# out here: it takes the FILE on stdin, writes nothing, changes nothing and
# needs no privilege — the same shape as `mdns-hosts-line` and `check-address`,
# and the same reason. No caller-supplied path enters this helper.
#
# It refuses rather than guesses. A file with no `Selection:` line, a selection
# this helper does not write, a custom choice with no addresses, or an address
# that does not parse by this script's own parsers all exit 2 with a message
# and print nothing — a repair that guessed would change what the user chose,
# which is the one thing it must never do.
selection_from_dropin() {
    local line selection='' servers='' over_tls='' address addresses=()
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '# Selection: '*) selection="${line#\# Selection: }" ;;
            'DNS='*)          servers="${line#DNS=}" ;;
            'DNSOverTLS='*)   over_tls="${line#DNSOverTLS=}" ;;
        esac
    done
    case "$selection" in
        cloudflare) echo "dns-use-cloudflare"; return 0 ;;
        quad9)      echo "dns-use-quad9"; return 0 ;;
        custom)     ;;
        '')
            echo "dns-selection-from-dropin: no 'Selection:' line in this file" >&2
            return 2
            ;;
        *)
            echo "dns-selection-from-dropin: this helper does not write that selection" >&2
            return 2
            ;;
    esac
    # A custom choice carries its addresses in the DNS= line, each optionally
    # followed by the certificate name after a '#'. The address is what is
    # read back; the name is this helper's own and is written again by the
    # apply verb, so it is not carried through a second time.
    for address in $servers; do
        address="${address%%#*}"
        [ -n "$address" ] || continue
        if ! valid_address "$address"; then
            echo "dns-selection-from-dropin: an address in this file does not parse" >&2
            return 2
        fi
        addresses+=("$address")
    done
    if [ "${#addresses[@]}" -eq 0 ]; then
        echo "dns-selection-from-dropin: a custom selection with no address" >&2
        return 2
    fi
    if [ "$over_tls" = "yes" ]; then
        echo "dns-use-custom encrypted ${addresses[*]}"
    else
        echo "dns-use-custom cleartext ${addresses[*]}"
    fi
}

# write_dns_dropin <selection-label> <DNS= value> <DNSOverTLS= value>
# All three arguments come from this script's own fixed branches except the
# address list for the custom selection, which has already been validated
# address by address above.
write_dns_dropin() {
    local selection="$1" servers="$2" over_tls="$3"
    mkdir -p "$RESOLVED_CONF_D"
    printf '%s\n' \
        '# Written by the InterGenOS Welcomer, name-lookup page.' \
        '#' \
        '# This file chooses the name servers this machine uses to turn names' \
        '# into addresses. To go back to the servers this network hands out,' \
        '# delete this file, or choose "Use what this network provides" on the' \
        '# name-lookup page of the Welcomer.' \
        '#' \
        '# Domains=~. is what makes these servers apply to every name. Without' \
        '# it the servers a network hands out would still be used for most' \
        '# lookups and the choice made here would apply to almost nothing.' \
        "# Selection: ${selection}" \
        '' \
        '[Resolve]' \
        "DNS=${servers}" \
        'Domains=~.' \
        "DNSOverTLS=${over_tls}" \
        > "$DNS_DROPIN"
    chmod 0644 "$DNS_DROPIN"
    restart_resolved
}

# unit_is_enabled <unit> — true when the unit is enabled to start on its own.
# `systemctl is-enabled` exits non-zero for a disabled unit, which under
# `set -e` would end this script, so every call sits inside a conditional.
unit_is_enabled() {
    systemctl is-enabled --quiet "$1" 2>/dev/null
}

# sync_cups_browsed — turn the network-printer daemon on when, and only when,
# BOTH halves it needs are on.
#
# cups-browsed builds local print destinations out of printers it hears
# advertised on the network. It needs the print scheduler (its unit declares
# Requires=cups.service) and it needs this machine's mDNS responder to hear the
# advertisements at all. So it is not a third switch: it follows the two
# choices the user has already made on this page, and it is turned off again
# the moment either one is turned off. Called by all four printing/discovery
# verbs, so the daemon's state is derived from the two units every time rather
# than tracked separately.
sync_cups_browsed() {
    if unit_is_enabled cups.socket && unit_is_enabled avahi-daemon.service; then
        systemctl enable --now cups-browsed.service
    else
        systemctl disable --now cups-browsed.service 2>/dev/null || true
    fi
}

# set_ipp_usb_dnssd on|off — let the USB printer daemon advertise, or not.
#
# The daemon serves the printer on the loopback address either way; what this
# changes is whether it publishes that service over DNS-SD. With the responder
# off, publishing cannot succeed and the daemon would write a failure line
# every two seconds for as long as the printer is plugged in, so the package
# ships it off and this turns it on with the rest of discovery. The edit is
# read back, because a substitution that matches nothing changes nothing.
set_ipp_usb_dnssd() {
    local want="$1" value
    case "$want" in
        on)  value=enable ;;
        off) value=disable ;;
        *)   echo "intergen-welcome-privhelper: set_ipp_usb_dnssd takes on|off" >&2
             return 1 ;;
    esac

    # The package may not be installed on this machine; that is not a failure
    # of the discovery choice.
    [ -f "$IPP_USB_CONF" ] || return 0

    sed -i "s/^\\( *dns-sd *= *\\)\\(enable\\|disable\\)/\\1${value}/" "$IPP_USB_CONF"
    if ! grep -qE "^ *dns-sd *= *${value}\\b" "$IPP_USB_CONF"; then
        echo "intergen-welcome-privhelper: could not set dns-sd = ${value} in $IPP_USB_CONF" >&2
        return 1
    fi

    # The daemon reads its configuration when it starts, which udev does when a
    # printer is plugged in. try-restart re-reads it for a printer that is
    # plugged in right now and does nothing when the daemon is not running.
    systemctl try-restart ipp-usb.service 2>/dev/null || true
}

case "${1:-}" in
    enable-printing)
        systemctl enable --now cups.socket
        u="$(caller_user)"
        if [ -n "$u" ]; then
            usermod -aG lpadmin "$u"
        fi
        # A USB printer needs nothing more: ipp-usb has no enablement state —
        # udev starts it when such a printer is plugged in and it exits when
        # the printer is unplugged. Network printers need the discovery half
        # too, which is what this follows.
        sync_cups_browsed
        ;;
    disable-printing)
        systemctl disable --now cups.socket cups.service cups.path 2>/dev/null || true
        sync_cups_browsed
        ;;
    enable-discovery)
        systemctl enable --now avahi-daemon.service
        set_mdns_hosts_order on
        mkdir -p "$NFTD"
        cat > "$MDNS_DROPIN" <<'NFT'
#!/usr/sbin/nft -f
# Added by the InterGenOS Welcomer "Enable Network Discovery" toggle.
# mDNS / DNS-SD (Avahi) — link-local multicast DNS on udp/5353. Delete this
# file (or toggle Network Discovery off in the Welcomer) to revert.
table inet filter {
    chain input {
        udp dport 5353 accept
    }
}
NFT
        reload_firewall
        set_ipp_usb_dnssd on
        sync_cups_browsed
        ;;
    disable-discovery)
        systemctl disable --now avahi-daemon.service avahi-daemon.socket 2>/dev/null || true
        set_mdns_hosts_order off
        rm -f "$MDNS_DROPIN"
        reload_firewall
        set_ipp_usb_dnssd off
        sync_cups_browsed
        ;;
    enable-ssh)
        systemctl enable --now sshd.service
        mkdir -p "$NFTD"
        cat > "$SSH_DROPIN" <<'NFT'
#!/usr/sbin/nft -f
# Added by the InterGenOS Welcomer "Enable SSH Server" toggle.
# OpenSSH inbound on tcp/22 (key-only authentication per D-007). Delete this
# file (or toggle SSH off in the Welcomer) to revert.
table inet filter {
    chain input {
        tcp dport 22 accept
    }
}
NFT
        reload_firewall
        ;;
    disable-ssh)
        systemctl disable --now sshd.service 2>/dev/null || true
        rm -f "$SSH_DROPIN"
        strip_legacy_ssh_rule /etc/nftables.conf
        reload_firewall
        ;;
    dns-use-network-default)
        # Removing the fragment IS the revert: the network's own servers were
        # never edited, they were only outranked while the fragment existed.
        rm -f "$DNS_DROPIN"
        restart_resolved
        ;;
    dns-use-cloudflare)
        write_dns_dropin cloudflare "$CLOUDFLARE_SERVERS" yes
        ;;
    dns-use-quad9)
        write_dns_dropin quad9 "$QUAD9_SERVERS" yes
        ;;
    dns-use-custom)
        # dns-use-custom {encrypted|cleartext} <address> [<address>...]
        shift
        mode="${1:-}"
        case "$mode" in
            encrypted|cleartext) shift ;;
            *)
                echo "dns-use-custom: first argument must be 'encrypted' or 'cleartext'" >&2
                exit 2
                ;;
        esac
        if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
            echo "dns-use-custom: expected 1 to 3 addresses, got $#" >&2
            exit 2
        fi
        for candidate in "$@"; do
            if ! valid_address "$candidate"; then
                # Deliberately does not echo the rejected value back: the
                # message goes to a log the user does not control the reader
                # of, and repeating an arbitrary string into it is a habit
                # worth not having.
                echo "dns-use-custom: refused — an argument is not a literal IPv4 or IPv6 address" >&2
                exit 3
            fi
        done
        if [ "$mode" = "encrypted" ]; then
            write_dns_dropin custom "$*" yes
        else
            write_dns_dropin custom "$*" no
        fi
        ;;
    mdns-hosts-line)
        # The hosts-line decision and nothing else — reads a nsswitch.conf on
        # STDIN, writes nothing, changes nothing, needs no privilege. Stdin
        # rather than a path on purpose: no caller-supplied filename enters this
        # helper, and a test can still feed it a file of its own.
        mdns_hosts_line "${2:-}" || exit $?
        ;;
    dns-selection-from-dropin)
        # The repair path's reading half — reads the drop-in on STDIN, prints
        # the verb that applies the same choice, writes nothing, needs no
        # privilege. Stdin rather than a path for the same reason as
        # `mdns-hosts-line`: no caller-supplied filename enters this helper.
        selection_from_dropin || exit $?
        ;;
    check-address)
        # Validation and nothing else — writes nothing, changes nothing, needs
        # no privilege. Exists so the Welcomer can check an address with the
        # same parser that will enforce it, before asking for a password.
        valid_address "${2:-}" || exit 2
        ;;
    *)
        echo "usage: intergen-welcome-privhelper {enable|disable}-{printing|discovery|ssh}" >&2
        echo "       intergen-welcome-privhelper dns-use-network-default" >&2
        echo "       intergen-welcome-privhelper dns-use-cloudflare" >&2
        echo "       intergen-welcome-privhelper dns-use-quad9" >&2
        echo "       intergen-welcome-privhelper dns-use-custom {encrypted|cleartext} <address> [<address>...]" >&2
        echo "       intergen-welcome-privhelper check-address <address>" >&2
        echo "       intergen-welcome-privhelper mdns-hosts-line {on|off} < nsswitch.conf" >&2
        echo "       intergen-welcome-privhelper dns-selection-from-dropin < 50-intergen-welcome-dns.conf" >&2
        exit 2
        ;;
esac
