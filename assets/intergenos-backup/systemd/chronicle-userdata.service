# chronicle-userdata.service — hourly user-data capture (spec §6).
#
# Oneshot fired by chronicle-userdata.timer. Captures the user-data layer
# (hardlink rotation against the target) WHILE the target volume is present;
# an absent target is a quiet skip that leaves the intent for reattach
# catch-up (spec §5). A capture whose estimated delta exceeds the off-peak
# threshold is enqueued, not run here — the drain runs from the off-peak
# timer.
#
# Same capability posture as chronicled.service: read every user's home
# (CAP_DAC_READ_SEARCH), write only the local store + mount roots. Restore's
# higher capabilities live in the separate chronicle-restore@.service.

[Unit]
Description=Chronicle hourly user-data capture
Documentation=man:chronicled(8) man:chronicle(1)

[Service]
Type=oneshot
User=root
ExecStart=/usr/libexec/chronicle/chronicled --task capture-userdata
StandardOutput=journal
StandardError=journal

StateDirectory=chronicle
RuntimeDirectory=chronicle
# The engine (chronicled.service) creates /run/chronicle as root:chronicle 0750
# and its socket inside as root:chronicle 0660 — the group is what lets a
# person's own account reach the engine. systemd re-applies a RuntimeDirectory's
# owner, group and mode — recursively, the socket included — every time ANY unit
# that declares it starts. Before 2026-09-20 this unit declared the directory
# with no Group= and the default 0755, so its first start after boot handed the
# directory and the socket back to root:root: from that moment until the engine
# was next restarted, the CLI and the backup application were refused with a
# message blaming a group membership the account already had, while root
# clients (the package manager's restore-point handler) kept working. Measured
# on two installed machines. Every unit that declares this directory therefore
# states the same group and mode as the engine, so whichever starts last leaves
# it as the engine needs it. This grants the unit nothing it lacked: it already
# runs as root.
Group=chronicle
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# Canonical daemon-hardening baseline + the ratified backup relaxations
# (identical set to chronicled.service; the read-all-of-home grant a backup
# capture requires).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
ReadWritePaths=/var/lib/chronicle /mnt /media /run/media
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
